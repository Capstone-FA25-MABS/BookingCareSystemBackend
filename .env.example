# AWS S3 Configuration
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_BUCKET_NAME=mabs-capstone-fa25-booking-care-s3-bucket
S3_REGION=ap-southeast-1

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=bookingcare
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_HOSTNAME=rabbitmq
RABBITMQ_PORT=5672

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=bookingcare
MONGO_INITDB_ROOT_PASSWORD=your_mongodb_password_here
MONGODB_CONNECTION_STRING=mongodb://bookingcare:your_mongodb_password_here@mongodb:27017

# Redis Configuration
REDIS_CONNECTION_STRING=redis:6379

# SQL Server - Discount Service
SQLSERVER_DISCOUNT_PASSWORD=your_discount_db_password_here
DISCOUNT_CONNECTION_STRING=Server=sqlserver-discount,1433;Database=MABS_Discount;User Id=sa;Password=your_discount_db_password_here;TrustServerCertificate=true

# SQL Server - Saga Service
SQLSERVER_SAGA_PASSWORD=your_saga_db_password_here
SAGA_CONNECTION_STRING=Server=sqlserver-saga,1433;Database=MABS_Sagas;User Id=sa;Password=your_saga_db_password_here;TrustServerCertificate=true

# SQL Server - User Service
SQLSERVER_USER_PASSWORD=your_user_db_password_here
USER_CONNECTION_STRING=Server=sqlserver-user,1433;Database=MABS_User;User Id=sa;Password=your_user_db_password_here;TrustServerCertificate=true

# SQL Server - Doctor Service
SQLSERVER_DOCTOR_PASSWORD=your_doctor_db_password_here
DOCTOR_CONNECTION_STRING=Server=sqlserver-doctor,1433;Database=MABS_Doctors;User Id=sa;Password=your_doctor_db_password_here;TrustServerCertificate=true

# SQL Server - Auth Service
SQLSERVER_AUTH_PASSWORD=your_auth_db_password_here
AUTH_CONNECTION_STRING=Server=sqlserver-auth,1433;Database=MABS_Auth;User Id=sa;Password=your_auth_db_password_here;TrustServerCertificate=true

# SQL Server - Appointment Service
SQLSERVER_APPOINTMENT_PASSWORD=your_appointment_db_password_here
APPOINTMENT_CONNECTION_STRING=Server=sqlserver-appointment,1433;Database=MABS_Appointment;User Id=sa;Password=your_appointment_db_password_here;TrustServerCertificate=true

# SQL Server - Hospital Service
SQLSERVER_HOSPITAL_PASSWORD=your_hospital_db_password_here
HOSPITAL_CONNECTION_STRING=Server=sqlserver-hospital,1433;Database=MABS_Hospital;User Id=sa;Password=your_hospital_db_password_here;TrustServerCertificate=true

# SQL Server - Schedule Service
SQLSERVER_SCHEDULE_PASSWORD=your_schedule_db_password_here
SCHEDULE_CONNECTION_STRING=Server=sqlserver-schedule,1433;Database=MABS_Schedule;User Id=sa;Password=your_schedule_db_password_here;TrustServerCertificate=true

# SQL Server - Payment Service
SQLSERVER_PAYMENT_PASSWORD=your_payment_db_password_here
PAYMENT_CONNECTION_STRING=Server=sqlserver-payment,1433;Database=MABS_Payment;User Id=sa;Password=your_payment_db_password_here;TrustServerCertificate=true

# SQL Server - ServiceMedical Service
SQLSERVER_SERVICEMEDICAL_PASSWORD=your_servicemedical_db_password_here
SERVICEMEDICAL_CONNECTION_STRING=Server=sqlserver-servicemedical,1433;Database=MABS_ServiceMedical;User Id=sa;Password=your_servicemedical_db_password_here;TrustServerCertificate=true

# SQL Server - AI Service
SQLSERVER_AI_PASSWORD=your_ai_db_password_here
AI_CONNECTION_STRING=Server=sqlserver-ai,1433;Database=MABS_AI;User Id=sa;Password=your_ai_db_password_here;TrustServerCertificate=true

# JWT Configuration
JWT_KEY=your_super_secret_jwt_key_at_least_256_bits_long
JWT_ISSUER=MicroGrpcDemo.Auth
JWT_AUDIENCE=MicroGrpcDemo.Services

# Application Environment
ASPNETCORE_ENVIRONMENT=Production
