# Monitoring Services Environment Configuration
# Copy to root .env file and customize as needed

# ============================================================
# GRAFANA CONFIGURATION
# ============================================================

# Grafana admin user (default: admin)
GRAFANA_ADMIN_USER=admin

# Grafana admin password (CHANGE THIS IN PRODUCTION)
GRAFANA_ADMIN_PASSWORD=admin

# Grafana server URL (used for notifications and links)
# Set to your domain in production
GRAFANA_SERVER_URL=http://localhost:3000

# ============================================================
# PROMETHEUS CONFIGURATION
# ============================================================

# Data retention period for Prometheus
# Default: 15d (15 days)
# Options: 15d, 30d, 60d, 90d, 180d, 365d
PROMETHEUS_RETENTION=15d

# ============================================================
# INFRASTRUCTURE MONITORING
# ============================================================

# Node Exporter settings
NODE_EXPORTER_ENABLED=true

# Redis Exporter settings
REDIS_EXPORTER_ENABLED=true

# ============================================================
# ALERT CONFIGURATION (Optional)
# ============================================================

# AlertManager host (if using AlertManager)
# ALERTMANAGER_HOST=alertmanager:9093

# Email notifications
# ALERT_EMAIL_FROM=alerts@bookingcare.com
# ALERT_EMAIL_TO=ops-team@bookingcare.com
# ALERT_SMTP_SERVER=smtp.gmail.com
# ALERT_SMTP_PORT=587

# Slack notifications
# ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# ALERT_SLACK_CHANNEL=#alerts

# ============================================================
# LOGGING & DEBUG
# ============================================================

# Enable verbose logging in Prometheus (debug|info)
PROMETHEUS_LOG_LEVEL=info

# Enable Grafana debug logging
# GRAFANA_LOG_LEVEL=debug

# ============================================================
# SECURITY (PRODUCTION)
# ============================================================

# Enable Prometheus authentication (optional)
# PROMETHEUS_AUTH_ENABLED=false
# PROMETHEUS_AUTH_USERNAME=admin
# PROMETHEUS_AUTH_PASSWORD=secure_password

# Enable HTTPS for Grafana
# GRAFANA_PROTOCOL=https
# GRAFANA_CERT_FILE=/certs/grafana.crt
# GRAFANA_KEY_FILE=/certs/grafana.key

# Enable HTTPS for Prometheus
# PROMETHEUS_PROTOCOL=https
# PROMETHEUS_CERT_FILE=/certs/prometheus.crt
# PROMETHEUS_KEY_FILE=/certs/prometheus.key

# ============================================================
# EXTERNAL MONITORING INTEGRATIONS
# ============================================================

# DataDog integration (optional)
# DATADOG_API_KEY=your_datadog_api_key
# DATADOG_ENABLED=false

# New Relic integration (optional)
# NEWRELIC_API_KEY=your_newrelic_api_key
# NEWRELIC_ENABLED=false

# ============================================================
# PERFORMANCE TUNING
# ============================================================

# Prometheus memory allocation
# Recommended: 2GB minimum, 4GB+ for production
PROMETHEUS_MEMORY=2g

# Grafana memory allocation
GRAFANA_MEMORY=1g

# Scrape interval for services (seconds)
# Lower = more accurate but higher CPU/storage
PROMETHEUS_SCRAPE_INTERVAL=15

# ============================================================
# BACKUP & RETENTION
# ============================================================

# Enable automatic backups
# BACKUP_ENABLED=true
# BACKUP_INTERVAL=24h
# BACKUP_LOCATION=/backups/monitoring

# ============================================================
# CUSTOM DASHBOARDS & PROVISIONING
# ============================================================

# Path to custom dashboards (optional)
# CUSTOM_DASHBOARDS_PATH=/etc/grafana/provisioning/dashboards

# Enable dashboard auto-reload
GRAFANA_AUTO_RELOAD_DASHBOARDS=true

# Auto-reload interval (seconds)
GRAFANA_AUTO_RELOAD_INTERVAL=10
