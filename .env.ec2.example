# BookingCare Environment Variables for EC2 Deployment
# Copy this file to .env and fill in your actual values

# AWS ECR Registry
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# Service Versions (auto-updated by GitHub Actions)
VERSION_APIGATEWAY=latest
VERSION_AI=latest
VERSION_ANALYTICS=latest
VERSION_APPOINTMENT=latest
VERSION_AUTH=latest
VERSION_BLOG=latest
VERSION_COMMUNICATION=latest
VERSION_CONTENT=latest
VERSION_DISCOUNT=latest
VERSION_DOCTOR=latest
VERSION_FAVORITES=latest
VERSION_HOSPITAL=latest
VERSION_NOTIFICATION=latest
VERSION_PAYMENT=latest
VERSION_REVIEW=latest
VERSION_SAGA=latest
VERSION_SCHEDULE=latest
VERSION_SERVICEMEDICAL=latest
VERSION_USER=latest

# Database Configuration
DB_CONNECTION_STRING=Server=your-db-host;Database=BookingCareDB;User Id=your-user;Password=your-password;TrustServerCertificate=true

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis Configuration (if using)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ISSUER=BookingCare
JWT_AUDIENCE=BookingCareClients
JWT_EXPIRATION_MINUTES=60

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration (if using)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@bookingcare.com
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# File Upload Configuration
FILE_UPLOAD_MAX_SIZE=10485760
FILE_UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf

# Logging
LOG_LEVEL=Information
SERILOG_MINIMUM_LEVEL=Information

# Application URLs
ASPNETCORE_ENVIRONMENT=Production
