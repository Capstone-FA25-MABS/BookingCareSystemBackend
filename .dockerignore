# .dockerignore for BookingCare System

# Git and version control
.git/
.gitignore
.gitattributes
**/.git/
**/.gitignore

# Documentation
*.md
README*
docs/
**/*.md
**/*.txt

# IDE and editor files
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
**/bin/
**/obj/
**/out/
**/.vs/
**/TestResults/
**/packages/
**/.nuget/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js (if any)
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Docker
**/.dockerignore
**/Dockerfile*
**/docker-compose*

# Monitoring and logs
**/monitoring/
**/logs/
**/*.log

# Scripts
**/scripts/
**/tools/

# Tests
**/tests/
**/*Test*/
**/*Tests*/

# Database files
**/*.db
**/*.sqlite
**/*.mdf
**/*.ldf

# Temporary files
**/tmp/
**/temp/
**/.tmp/
**/.temp/
