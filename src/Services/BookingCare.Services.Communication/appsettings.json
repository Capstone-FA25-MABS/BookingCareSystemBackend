{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "CommunicationDB"
  },
  "FileUpload": {
    "Provider": "Cloudinary",
    "CdnBaseUrl": "",
    "ContainerName": "bookingcare-communication",
    "Cloudinary": {
      "CloudName": "xxxxx",
      "ApiKey": "xxxxx",
      "ApiSecret": "xxxxx",
      "BaseUrl": "https://res.cloudinary.com",
      "AutoOptimize": true,
      "AutoFormat": true
    },
    "Constraints": {
      "Text": {
        "MaxSizeBytes": 0,
        "AllowedMimeTypes": []
      },
      "Image": {
        "MaxSizeBytes": 10485760,
        "AllowedMimeTypes": [
          "image/jpeg",
          "image/png",
          "image/gif",
          "image/webp"
        ],
        "MaxWidth": 4096,
        "MaxHeight": 4096,
        "GenerateThumbnail": true,
        "ThumbnailSize": 300
      },
      "File": {
        "MaxSizeBytes": 209715200,
        "AllowedMimeTypes": [
          "application/pdf",
          "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "application/vnd.ms-excel",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "application/zip",
          "application/x-rar-compressed",
          "text/plain"
        ]
      },
      "Video": {
        "MaxSizeBytes": 104857600,
        "AllowedMimeTypes": [
          "video/mp4",
          "video/avi",
          "video/mov",
          "video/webm"
        ],
        "MaxDurationSeconds": 300,
        "GenerateThumbnail": true,
        "ThumbnailSize": 300
      },
      "Audio": {
        "MaxSizeBytes": 52428800,
        "AllowedMimeTypes": [
          "audio/mp3",
          "audio/wav",
          "audio/ogg",
          "audio/m4a"
        ],
        "MaxDurationSeconds": 600
      },
      "VoiceNote": {
        "MaxSizeBytes": 10485760,
        "AllowedMimeTypes": [
          "audio/mp3",
          "audio/wav",
          "audio/ogg",
          "audio/m4a"
        ],
        "MaxDurationSeconds": 120
      }
    }
  },
  "AWS": {
    "S3": {
      "AccessKey": "your-aws-access-key",
      "SecretKey": "your-aws-secret-key",
      "BucketName": "bookingcare-communication",
      "Region": "ap-southeast-1",
      "CloudFrontDomain": "your-cloudfront-domain.cloudfront.net",
      "CloudFrontDistributionId": "your-distribution-id",
      "PresignedUrlExpiryHours": 1,
      "MaxFileSizeBytes": 209715200,
      "AllowedFileExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp",
        ".mp4",
        ".avi",
        ".mov",
        ".webm",
        ".mp3",
        ".wav",
        ".ogg",
        ".m4a",
        ".pdf",
        ".doc",
        ".docx",
        ".txt",
        ".rtf"
      ],
      "FileUploadPath": "communication/"
    },
    "CloudFront": {
      "DistributionId": "your-distribution-id",
      "Domain": "your-cloudfront-domain.cloudfront.net",
      "CacheTtlSeconds": 86400,
      "EnableInvalidation": true
    }
  },
  "EnhancedFileUpload": {
    "Strategy": "Hybrid",
    "RoutingRules": {
      "File": "AWS",
      "Audio": "AWS",
      "VoiceNote": "AWS",
      "Image": "Cloudinary",
      "Video": "Cloudinary"
    },
    "S3": {
      "AccessKey": "your-aws-access-key",
      "SecretKey": "your-aws-secret-key",
      "BucketName": "bookingcare-communication",
      "Region": "ap-southeast-1",
      "PresignedUrlExpiryHours": 1,
      "MaxFileSizeBytes": 209715200,
      "AllowedFileExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp",
        ".mp4",
        ".avi",
        ".mov",
        ".webm",
        ".mp3",
        ".wav",
        ".ogg",
        ".m4a",
        ".pdf",
        ".doc",
        ".docx",
        ".txt",
        ".rtf"
      ],
      "FileUploadPath": "communication/"
    },
    "CloudFront": {
      "DistributionId": "your-distribution-id",
      "Domain": "your-cloudfront-domain.cloudfront.net",
      "CacheTtlSeconds": 86400,
      "EnableInvalidation": true,
      "CacheableExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp",
        ".mp4",
        ".avi",
        ".mov",
        ".webm",
        ".mp3",
        ".wav",
        ".ogg",
        ".m4a",
        ".pdf"
      ]
    },
    "Performance": {
      "EnableParallelUploads": true,
      "MaxConcurrentUploads": 3,
      "EnableImageCompression": true,
      "EnableFormatOptimization": true,
      "Thumbnails": {
        "EnableAutoGeneration": true,
        "DefaultSize": 300,
        "Quality": "auto:good",
        "SupportedFormats": [
          "jpg",
          "png",
          "webp"
        ]
      }
    }
  }
}
