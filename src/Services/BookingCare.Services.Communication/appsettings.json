{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb://bookingcare:password123@localhost:27017",
    "DatabaseName": "MABS_Communication"
  },
  "Cache": {
    "ConnectionString": "localhost:6379",
    "DefaultExpirationInMinutes": 30,
    "KeyPrefix": "BookingCare:Communication:",
    "Database": 0,
    "Enabled": true,
    "RetryCount": 3,
    "ConnectTimeout": 5,
    "CommandTimeout": 5
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "bookingcare",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "booking_care_event_bus",
    "QueueName": "communication-service-queue",
    "RetryCount": 3,
    "ConnectionTimeout": 30000,
    "RequestedHeartbeat": 60,
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryInterval": 5000,
    "PersistentMessages": true,
    "AutoDeleteQueue": false,
    "DurableQueue": true,
    "ExclusiveQueue": false
  },
  "GrpcServices": {
    "AuthService": {
      "Url": "http://localhost:6103"
    },
    "UserService": {
      "Url": "http://localhost:6116"
    }
  },
  "FileUpload": {
    "Provider": "S3",
    "CdnBaseUrl": "",
    "ContainerName": "bookingcare-communication",
    "Constraints": {
      "Text": {
        "MaxSizeBytes": 0,
        "AllowedMimeTypes": []
      },
      "Image": {
        "MaxSizeBytes": 10485760,
        "AllowedMimeTypes": [
          "image/jpeg",
          "image/png",
          "image/gif",
          "image/webp"
        ],
        "MaxWidth": 4096,
        "MaxHeight": 4096,
        "GenerateThumbnail": false,
        "ThumbnailSize": 300
      },
      "File": {
        "MaxSizeBytes": 209715200,
        "AllowedMimeTypes": [
          "application/pdf",
          "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "application/vnd.ms-excel",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "application/zip",
          "application/x-rar-compressed",
          "text/plain"
        ]
      },
      "Video": {
        "MaxSizeBytes": 104857600,
        "AllowedMimeTypes": [
          "video/mp4",
          "video/avi",
          "video/mov",
          "video/webm"
        ],
        "MaxDurationSeconds": 300,
        "GenerateThumbnail": false,
        "ThumbnailSize": 300
      },
      "Audio": {
        "MaxSizeBytes": 52428800,
        "AllowedMimeTypes": [
          "audio/mp3",
          "audio/wav",
          "audio/ogg",
          "audio/m4a"
        ],
        "MaxDurationSeconds": 600
      },
      "VoiceNote": {
        "MaxSizeBytes": 10485760,
        "AllowedMimeTypes": [
          "audio/mp3",
          "audio/wav",
          "audio/ogg",
          "audio/m4a"
        ],
        "MaxDurationSeconds": 120
      }
    }
  },
  "AWS": {
    "S3": {
      "AccessKey": "xxxx",
      "SecretKey": "xxxx",
      "BucketName": "mabs-capstone-fa25-booking-care-s3-bucket",
      "Region": "ap-southeast-1",
      "CloudFrontDomain": "d24em9p7s2uixh.cloudfront.net",
      "CloudFrontDistributionId": "E3BCCKKHWEEXE3",
      "PresignedUrlExpiryHours": 1,
      "MaxFileSizeBytes": 209715200,
      "AllowedFileExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp",
        ".mp4",
        ".avi",
        ".mov",
        ".webm",
        ".mp3",
        ".wav",
        ".ogg",
        ".m4a",
        ".pdf",
        ".doc",
        ".docx",
        ".txt",
        ".rtf"
      ],
      "FileUploadPath": "communication/"
    },
    "CloudFront": {
      "DistributionId": "E3BCCKKHWEEXE3",
      "Domain": "d24em9p7s2uixh.cloudfront.net",
      "CacheTtlSeconds": 86400,
      "EnableInvalidation": true
    }
  },
  "EnhancedFileUpload": {
    "Strategy": "S3Only",
    "ForceS3": true,
    "RoutingRules": {
      "File": "AWS",
      "Audio": "AWS",
      "VoiceNote": "AWS",
      "Image": "AWS",
      "Video": "AWS"
    },
    "Performance": {
      "EnableParallelUploads": true,
      "MaxConcurrentUploads": 3,
      "EnableImageCompression": false,
      "EnableFormatOptimization": false,
      "Thumbnails": {
        "EnableAutoGeneration": false,
        "DefaultSize": 300,
        "Quality": "auto:good",
        "SupportedFormats": [
          "jpg",
          "png",
          "webp"
        ]
      }
    }
  }
}
