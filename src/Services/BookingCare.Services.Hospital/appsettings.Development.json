{
  "Kestrel": {
    "HttpPort": 6004,
    "GrpcPort": 6104,
    "EnableGrpc": true,
    "MaxConcurrentConnections": 100,
    "MaxConcurrentUpgradedConnections": 100,
    "MaxRequestBodySize": 31457280,
    "RequestHeadersTimeoutSeconds": 30,
    "KeepAliveTimeoutSeconds": 120
  },
  "GrpcClients": {
    "Auth": {
      "Address": "http://localhost:6103"
    },
    "Doctor": {
      "Address": "http://localhost:6108"
    },
    "ServiceMedical": {
      "Address": "http://localhost:6115"
    },
    "Review": {
      "Address": "http://localhost:6112"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
