{
    "Kestrel": {
        "HttpPort": 6012,
        "GrpcPort": 6112,
        "EnableGrpc": true,
        "MaxConcurrentConnections": 100,
        "MaxConcurrentUpgradedConnections": 100,
        "MaxRequestBodySize": 31457280,
        "RequestHeadersTimeoutSeconds": 30,
        "KeepAliveTimeoutSeconds": 120
    },
    "Services": {
        "Auth": {
            "GrpcUrl": "http://localhost:6103"
        },
      "User": {
        "GrpcUrl": "http://localhost:6116"
      },
      "Appointment": {
        "GrpcUrl": "http://localhost:6102"
      }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    }
}