# Doctor Service Environment Configuration
# Copy this file to .env and customize the values

# Database configuration
DOCTOR_DB_PASSWORD=Doctor123!
DOCTOR_DB_NAME=MABS_Doctor
DOCTOR_DB_PORT=1435

# Service configuration
ASPNETCORE_ENVIRONMENT=Development
DOCTOR_SERVICE_HTTP_PORT=6008
DOCTOR_SERVICE_GRPC_PORT=6018

# Connection string template
# ConnectionStrings__DefaultConnection=Server=localhost,1435;Database=MABS_Doctor;User Id=sa;Password=Doctor123!;TrustServerCertificate=true;

# Logging configuration
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Health check configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s
