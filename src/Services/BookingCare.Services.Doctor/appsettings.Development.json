{
  "Kestrel": {
    "HttpPort": 6008,
    "GrpcPort": 6108,
    "EnableGrpc": true,
    "MaxConcurrentConnections": 100,
    "MaxConcurrentUpgradedConnections": 100,
    "MaxRequestBodySize": 31457280,
    "RequestHeadersTimeoutSeconds": 30,
    "KeepAliveTimeoutSeconds": 120
  },
  "GrpcClients": {
    "Favorites": {
      "Address": "http://localhost:6109"
    },
    "Auth": {
      "Address": "http://localhost:6103"
    },
    "Hospital": {
      "Address": "http://localhost:6104"
    },
    "Review": {
      "Address": "http://localhost:6112"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
