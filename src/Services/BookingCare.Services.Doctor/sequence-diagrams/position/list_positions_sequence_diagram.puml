@startuml
title List Positions

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Admin
participant UI
participant PositionsController
participant PositionService
participant PositionRepository
participant AutoMapper
database Database

Admin -> UI : 1. Click "View Positions" or load positions page
activate UI
UI -> PositionsController : 2. GetPositionsList(PositionQueryRequest)
activate PositionsController

PositionsController -> PositionService : 3. GetPositionsAsync(PositionQueryRequest)
activate PositionService

PositionService -> PositionRepository : 4. GetPositionsAsync(PositionQueryRequest)
activate PositionRepository
PositionRepository -> Database : 5. GetPositionsData(PositionQueryRequest)
activate Database
Database --> PositionRepository : 6. List<PositionEntity>
deactivate Database

PositionRepository -> Database : 7. GetPositionsCount(PositionQueryRequest)
activate Database
Database --> PositionRepository : 8. TotalCount
deactivate Database
PositionRepository --> PositionService : 9. (List<PositionEntity>, TotalCount)
deactivate PositionRepository

PositionService -> AutoMapper : 10. Map((List<PositionEntity>, TotalCount) → PositionListResponse)
activate AutoMapper
AutoMapper --> PositionService : 11. PositionListResponse
deactivate AutoMapper

PositionService -> PositionService : 12. Set pagination info (PageNumber, PageSize, TotalPages)
activate PositionService
deactivate PositionService

PositionService --> PositionsController : 13. PositionListResponse
deactivate PositionService

PositionsController --> UI : 14. Return PositionListResponse
deactivate PositionsController

UI --> Admin : 15. Render positions list on screen
deactivate UI

@enduml
