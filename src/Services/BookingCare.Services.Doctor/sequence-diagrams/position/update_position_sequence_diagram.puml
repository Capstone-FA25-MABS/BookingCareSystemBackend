@startuml
title Update Position

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Admin
participant UI
participant PositionsController
participant PositionService
participant PositionRepository
participant AutoMapper
database Database

Admin -> UI : 1. Edit position form and click "Update Position"
activate UI
UI -> PositionsController : 2. UpdatePosition(id, UpdatePositionRequest)
activate PositionsController

PositionsController -> PositionService : 3. UpdatePositionAsync(UpdatePositionRequest)
activate PositionService

PositionService -> PositionRepository : 4. GetPositionByIdAsync(positionId)
activate PositionRepository
PositionRepository -> Database : 5. GetPositionDataById(id)
activate Database
Database --> PositionRepository : 6. PositionEntity
deactivate Database
PositionRepository --> PositionService : 7. PositionEntity
deactivate PositionRepository

alt Position not found
    PositionService --> PositionsController : 8. PositionNotFoundException.WithId(positionId)
    deactivate PositionService
    PositionsController --> UI : 9. Return not found error
    deactivate PositionsController
    UI --> Admin : 10. Show "Position not found"
    deactivate UI
else Position found

    alt Position name is being updated
        PositionService -> PositionRepository : 8. PositionNameExistsAsync(name, excludeId)
        activate PositionRepository
        PositionRepository -> Database : 9. CheckPositionNameExistsExcludingId(name, excludeId)
        activate Database
        Database --> PositionRepository : 10. boolean exists
        deactivate Database
        PositionRepository --> PositionService : 11. boolean exists
        deactivate PositionRepository

        alt Position name already exists
            PositionService --> PositionsController : 12. PositionConflictException.WithName(name)
            deactivate PositionService
            PositionsController --> UI : 13. Return conflict error
            deactivate PositionsController
            UI --> Admin : 14. Show "Position name already exists"
            deactivate UI
        else Position name is unique
            note right: Continue to update position
        end
    end

    PositionService -> AutoMapper : 15. Map(request, existingPosition)
    activate AutoMapper
    AutoMapper --> PositionService : 16. Updated PositionEntity
    deactivate AutoMapper

    PositionService -> PositionService : 17. Set UpdatedAt = DateTime.UtcNow
    activate PositionService
    deactivate PositionService

    PositionService -> PositionRepository : 18. UpdatePositionAsync(updatedPosition)
    activate PositionRepository
    PositionRepository -> Database : 19. UpdatePositionData(updatedPosition)
    activate Database
    Database --> PositionRepository : 20. Updated count
    deactivate Database
    PositionRepository --> PositionService : 21. PositionEntity
    deactivate PositionRepository

    PositionService -> AutoMapper : 22. Map(PositionEntity → PositionResponse)
    activate AutoMapper
    AutoMapper --> PositionService : 23. PositionResponse
    deactivate AutoMapper

    PositionService --> PositionsController : 24. PositionResponse
    deactivate PositionService

    PositionsController --> UI : 25. Return PositionResponse
    deactivate PositionsController

    UI --> Admin : 26. Show "Position updated successfully"
    deactivate UI
end

@enduml
