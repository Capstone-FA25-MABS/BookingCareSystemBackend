@startuml
title Update Language

actor Admin
participant UI
participant LanguagesController
participant LanguageService
participant LanguageRepository
participant AutoMapper
database Database

== UI Request ==
Admin -> UI : 1. Edit language form and click "Update Language"
activate UI
UI -> LanguagesController : 2. HTTP PUT /api/languages/{id} (UpdateLanguageRequest)
activate LanguagesController

== Service Call ==
LanguagesController -> LanguageService : 3. UpdateLanguageAsync(UpdateLanguageRequest)
activate LanguageService

== Validate Language Exists ==
LanguageService -> LanguageRepository : 4. GetLanguageByIdAsync(languageId)
activate LanguageRepository
LanguageRepository -> Database : 5. SELECT * FROM Languages WHERE Id = @id
activate Database
Database --> LanguageRepository : 6. LanguageEntity
deactivate Database
LanguageRepository --> LanguageService : 7. LanguageEntity
deactivate LanguageRepository

alt Language not found
    LanguageService --> LanguagesController : 8. ArgumentException("Language with ID not found")
    deactivate LanguageService
    LanguagesController --> UI : 9. HTTP 400 Bad Request
    deactivate LanguagesController
    UI --> Admin : 10. Show "Language not found"
    deactivate UI
else Language found

    == Validate Language Name (if changed) ==
    LanguageService -> LanguageRepository : 8. LanguageNameExistsAsync(name, excludeId)
    activate LanguageRepository
    LanguageRepository -> Database : 9. SELECT COUNT(*) FROM Languages WHERE Name = @name AND Id != @excludeId
    activate Database
    Database --> LanguageRepository : 10. boolean exists
    deactivate Database
    LanguageRepository --> LanguageService : 11. boolean exists
    deactivate LanguageRepository

    alt Language name already exists
        LanguageService --> LanguagesController : 12. ArgumentException("Language with name already exists")
        deactivate LanguageService
        LanguagesController --> UI : 13. HTTP 400 Bad Request
        deactivate LanguagesController
        UI --> Admin : 14. Show "Language name already exists"
        deactivate UI
    else Language name is unique
        note right: Continue to update language

        == Update Language Entity ==
        LanguageService -> AutoMapper : 15. Map(request, existingLanguage)
        activate AutoMapper
        AutoMapper --> LanguageService : 16. Updated LanguageEntity
        deactivate AutoMapper

        LanguageService -> LanguageService : 17. Set UpdatedAt = DateTime.UtcNow
        activate LanguageService
        deactivate LanguageService

        == Save Updated Language ==
        LanguageService -> LanguageRepository : 18. UpdateLanguageAsync(updatedLanguage)
        activate LanguageRepository
        LanguageRepository -> Database : 19. UPDATE Languages SET Name = @name, Status = @status, UpdatedAt = @now WHERE Id = @id
        activate Database
        Database --> LanguageRepository : 20. Updated count
        deactivate Database
        LanguageRepository --> LanguageService : 21. LanguageEntity
        deactivate LanguageRepository

        == Map to Response DTO ==
        LanguageService -> AutoMapper : 22. Map(LanguageEntity → LanguageResponse)
        activate AutoMapper
        AutoMapper --> LanguageService : 23. LanguageResponse
        deactivate AutoMapper

        LanguageService --> LanguagesController : 24. LanguageResponse
        deactivate LanguageService

        LanguagesController --> UI : 25. HTTP 200 OK (LanguageResponse)
        deactivate LanguagesController

        UI --> Admin : 26. Show "Language updated successfully"
        deactivate UI
    end
end

@enduml
