@startuml
title Create Doctor Service Type

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Admin
participant UI
participant ServiceTypesController
participant ServiceTypeService
participant ServiceTypeRepository
participant AutoMapper
database Database

Admin -> UI : 1. Fill Doctor Service Type form and click "Create Doctor Service Type"
activate UI
UI -> ServiceTypesController : 2. CreateServiceType(CreateServiceTypeRequest)
activate ServiceTypesController

ServiceTypesController -> ServiceTypeService : 3. CreateServiceTypeAsync(CreateServiceTypeRequest)
activate ServiceTypeService

ServiceTypeService -> ServiceTypeRepository : 4. ServiceTypeNameExistsAsync(name)
activate ServiceTypeRepository
ServiceTypeRepository -> Database : 5. CheckServiceTypeNameExists(name)
activate Database
Database --> ServiceTypeRepository : 6. boolean exists
deactivate Database
ServiceTypeRepository --> ServiceTypeService : 7. boolean exists
deactivate ServiceTypeRepository

alt Doctor Service Type name already exists
    ServiceTypeService --> ServiceTypesController : 8. ArgumentException("Doctor Service Type with name already exists")
    deactivate ServiceTypeService
    ServiceTypesController --> UI : 9. Return bad request error
    deactivate ServiceTypesController
    UI --> Admin : 10. Show "Doctor Service Type name already exists"
    deactivate UI
else Doctor Service Type name is unique

    ServiceTypeService -> AutoMapper : 8. Map(CreateServiceTypeRequest → ServiceTypeEntity)
    activate AutoMapper
    AutoMapper --> ServiceTypeService : 9. ServiceTypeEntity (with new Guid)
    deactivate AutoMapper

    ServiceTypeService -> ServiceTypeService : 10. Set Id = Guid.NewGuid()
    activate ServiceTypeService
    deactivate ServiceTypeService

    ServiceTypeService -> ServiceTypeRepository : 11. CreateServiceTypeAsync(serviceType)
    activate ServiceTypeRepository
    ServiceTypeRepository -> Database : 12. CreateServiceTypeData(serviceType)
    activate Database
    Database --> ServiceTypeRepository : 13. ServiceTypeEntity created
    deactivate Database
    ServiceTypeRepository --> ServiceTypeService : 14. ServiceTypeEntity
    deactivate ServiceTypeRepository

    ServiceTypeService -> AutoMapper : 15. Map(ServiceTypeEntity → ServiceTypeResponse)
    activate AutoMapper
    AutoMapper --> ServiceTypeService : 16. ServiceTypeResponse
    deactivate AutoMapper

    ServiceTypeService --> ServiceTypesController : 17. ServiceTypeResponse
    deactivate ServiceTypeService

    ServiceTypesController --> UI : 18. Return ServiceTypeResponse
    deactivate ServiceTypesController

    UI --> Admin : 19. Show "Doctor Service Type created successfully"
    deactivate UI
end

@enduml
