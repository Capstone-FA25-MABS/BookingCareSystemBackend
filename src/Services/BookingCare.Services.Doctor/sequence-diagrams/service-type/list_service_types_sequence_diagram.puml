@startuml
title List Doctor Service Types

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Admin
participant UI
participant ServiceTypesController
participant ServiceTypeService
participant ServiceTypeRepository
participant AutoMapper
database Database

Admin -> UI : 1. Click "View Doctor Service Types" or load Doctor Service Types page
activate UI
UI -> ServiceTypesController : 2. GetServiceTypesList(ServiceTypeQueryRequest)
activate ServiceTypesController

ServiceTypesController -> ServiceTypeService : 3. GetServiceTypesAsync(ServiceTypeQueryRequest)
activate ServiceTypeService

ServiceTypeService -> ServiceTypeRepository : 4. GetServiceTypesAsync(ServiceTypeQueryRequest)
activate ServiceTypeRepository
ServiceTypeRepository -> Database : 5. GetServiceTypesData(ServiceTypeQueryRequest)
activate Database
Database --> ServiceTypeRepository : 6. List<ServiceTypeEntity>
deactivate Database

ServiceTypeRepository -> Database : 7. GetServiceTypesCount(ServiceTypeQueryRequest)
activate Database
Database --> ServiceTypeRepository : 8. TotalCount
deactivate Database
ServiceTypeRepository --> ServiceTypeService : 9. (List<ServiceTypeEntity>, TotalCount)
deactivate ServiceTypeRepository

ServiceTypeService -> AutoMapper : 10. Map((List<ServiceTypeEntity>, TotalCount) → ServiceTypeListResponse)
activate AutoMapper
AutoMapper --> ServiceTypeService : 11. ServiceTypeListResponse
deactivate AutoMapper

ServiceTypeService -> ServiceTypeService : 12. Set pagination info (PageNumber, PageSize, TotalPages)
activate ServiceTypeService
deactivate ServiceTypeService

ServiceTypeService --> ServiceTypesController : 13. ServiceTypeListResponse
deactivate ServiceTypeService

ServiceTypesController --> UI : 14. Return ServiceTypeListResponse
deactivate ServiceTypesController

UI --> Admin : 15. Render Doctor Service Types list on screen
deactivate UI

@enduml
