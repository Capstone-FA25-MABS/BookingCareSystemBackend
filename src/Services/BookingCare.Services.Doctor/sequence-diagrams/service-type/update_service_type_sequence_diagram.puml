@startuml
title Update Doctor Service Type

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Admin
participant UI
participant ServiceTypesController
participant ServiceTypeService
participant ServiceTypeRepository
participant AutoMapper
database Database

Admin -> UI : 1. Edit Doctor Service Type form and click "Update Doctor Service Type"
activate UI
UI -> ServiceTypesController : 2. UpdateServiceType(id, UpdateServiceTypeRequest)
activate ServiceTypesController

ServiceTypesController -> ServiceTypeService : 3. UpdateServiceTypeAsync(UpdateServiceTypeRequest)
activate ServiceTypeService

ServiceTypeService -> ServiceTypeRepository : 4. GetServiceTypeByIdAsync(serviceTypeId)
activate ServiceTypeRepository
ServiceTypeRepository -> Database : 5. GetServiceTypeDataById(id)
activate Database
Database --> ServiceTypeRepository : 6. ServiceTypeEntity
deactivate Database
ServiceTypeRepository --> ServiceTypeService : 7. ServiceTypeEntity
deactivate ServiceTypeRepository

alt Doctor Service Type not found
    ServiceTypeService --> ServiceTypesController : 8. ArgumentException("Doctor Service Type with ID not found")
    deactivate ServiceTypeService
    ServiceTypesController --> UI : 9. Return bad request error
    deactivate ServiceTypesController
    UI --> Admin : 10. Show "Doctor Service Type not found"
    deactivate UI
else Doctor Service Type found

    ServiceTypeService -> ServiceTypeRepository : 8. ServiceTypeNameExistsAsync(name, excludeId)
    activate ServiceTypeRepository
    ServiceTypeRepository -> Database : 9. CheckServiceTypeNameExistsExcludingId(name, excludeId)
    activate Database
    Database --> ServiceTypeRepository : 10. boolean exists
    deactivate Database
    ServiceTypeRepository --> ServiceTypeService : 11. boolean exists
    deactivate ServiceTypeRepository

    alt Doctor Service Type name already exists
        ServiceTypeService --> ServiceTypesController : 12. ArgumentException("Doctor Service Type with name already exists")
        deactivate ServiceTypeService
        ServiceTypesController --> UI : 13. Return bad request error
        deactivate ServiceTypesController
        UI --> Admin : 14. Show "Doctor Service Type name already exists"
        deactivate UI
    else Doctor Service Type name is unique
        note right: Continue to update Doctor Service Type

        ServiceTypeService -> AutoMapper : 15. Map(request, existingServiceType)
        activate AutoMapper
        AutoMapper --> ServiceTypeService : 16. Updated ServiceTypeEntity
        deactivate AutoMapper

        ServiceTypeService -> ServiceTypeService : 17. Set UpdatedAt = DateTime.UtcNow
        activate ServiceTypeService
        deactivate ServiceTypeService

        ServiceTypeService -> ServiceTypeRepository : 18. UpdateServiceTypeAsync(updatedServiceType)
        activate ServiceTypeRepository
        ServiceTypeRepository -> Database : 19. UpdateServiceTypeData(updatedServiceType)
        activate Database
        Database --> ServiceTypeRepository : 20. Updated count
        deactivate Database
        ServiceTypeRepository --> ServiceTypeService : 21. ServiceTypeEntity
        deactivate ServiceTypeRepository

        ServiceTypeService -> AutoMapper : 22. Map(ServiceTypeEntity → ServiceTypeResponse)
        activate AutoMapper
        AutoMapper --> ServiceTypeService : 23. ServiceTypeResponse
        deactivate AutoMapper

        ServiceTypeService --> ServiceTypesController : 24. ServiceTypeResponse
        deactivate ServiceTypeService

        ServiceTypesController --> UI : 25. Return ServiceTypeResponse
        deactivate ServiceTypesController

        UI --> Admin : 26. Show "Doctor Service Type updated successfully"
        deactivate UI
    end
end

@enduml
