@startuml
title Create Specialty

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Admin
participant UI
participant SpecialtiesController
participant SpecialtyService
participant SpecialtyRepository
participant AutoMapper
database Database

Admin -> UI : 1. Fill specialty form and click "Create Specialty"
activate UI
UI -> SpecialtiesController : 2. CreateSpecialty(CreateSpecialtyRequest)
activate SpecialtiesController

SpecialtiesController -> SpecialtyService : 3. CreateSpecialtyAsync(CreateSpecialtyRequest)
activate SpecialtyService

SpecialtyService -> SpecialtyRepository : 4. SpecialtyNameExistsAsync(name)
activate SpecialtyRepository
SpecialtyRepository -> Database : 5. CheckSpecialtyNameExists(name)
activate Database
Database --> SpecialtyRepository : 6. boolean exists
deactivate Database
SpecialtyRepository --> SpecialtyService : 7. boolean exists
deactivate SpecialtyRepository

alt Specialty name already exists
    SpecialtyService --> SpecialtiesController : 8. SpecialtyConflictException.WithName(name)
    deactivate SpecialtyService
    SpecialtiesController --> UI : 9. Return conflict error
    deactivate SpecialtiesController
    UI --> Admin : 10. Show "Specialty name already exists"
    deactivate UI
else Specialty name is unique

    SpecialtyService -> AutoMapper : 8. Map(CreateSpecialtyRequest → SpecialtyEntity)
    activate AutoMapper
    AutoMapper --> SpecialtyService : 9. SpecialtyEntity (with new Guid)
    deactivate AutoMapper

    SpecialtyService -> SpecialtyService : 10. Set Id = Guid.NewGuid()
    activate SpecialtyService
    deactivate SpecialtyService

    SpecialtyService -> SpecialtyRepository : 11. CreateSpecialtyAsync(specialty)
    activate SpecialtyRepository
    SpecialtyRepository -> Database : 12. CreateSpecialtyData(specialty)
    activate Database
    Database --> SpecialtyRepository : 13. SpecialtyEntity created
    deactivate Database
    SpecialtyRepository --> SpecialtyService : 14. SpecialtyEntity
    deactivate SpecialtyRepository

    SpecialtyService -> AutoMapper : 15. Map(SpecialtyEntity → SpecialtyResponse)
    activate AutoMapper
    AutoMapper --> SpecialtyService : 16. SpecialtyResponse
    deactivate AutoMapper

    SpecialtyService --> SpecialtiesController : 17. SpecialtyResponse
    deactivate SpecialtyService

    SpecialtiesController --> UI : 18. Return SpecialtyResponse
    deactivate SpecialtiesController

    UI --> Admin : 19. Show "Specialty created successfully"
    deactivate UI
end

@enduml
