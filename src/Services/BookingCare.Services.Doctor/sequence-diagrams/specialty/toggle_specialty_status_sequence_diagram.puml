@startuml
title Toggle Specialty Status

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Admin
participant UI
participant SpecialtiesController
participant SpecialtyService
participant SpecialtyRepository
participant AutoMapper
database Database

Admin -> UI : 1. Click "Toggle Status" button on specialty
activate UI
UI -> SpecialtiesController : 2. ToggleSpecialtyStatus(id)
activate SpecialtiesController

SpecialtiesController -> SpecialtyService : 3. ToggleSpecialtyStatusAsync(Guid id)
activate SpecialtyService

SpecialtyService -> SpecialtyRepository : 4. GetSpecialtyByIdAsync(specialtyId)
activate SpecialtyRepository
SpecialtyRepository -> Database : 5. GetSpecialtyDataById(id)
activate Database
Database --> SpecialtyRepository : 6. SpecialtyEntity
deactivate Database
SpecialtyRepository --> SpecialtyService : 7. SpecialtyEntity
deactivate SpecialtyRepository

alt Specialty not found
    SpecialtyService --> SpecialtiesController : 8. SpecialtyNotFoundException.WithId(specialtyId)
    deactivate SpecialtyService
    SpecialtiesController --> UI : 9. Return not found error
    deactivate SpecialtiesController
    UI --> Admin : 10. Show "Specialty not found"
    deactivate UI
else Specialty found

    SpecialtyService -> SpecialtyService : 8. Toggle status logic
    activate SpecialtyService
    alt Current status is ACTIVE
        SpecialtyService -> SpecialtyService : 9. Set Status = INACTIVE
    else Current status is INACTIVE
        SpecialtyService -> SpecialtyService : 9. Set Status = ACTIVE
    end
    SpecialtyService -> SpecialtyService : 10. Set UpdatedAt = DateTime.UtcNow
    deactivate SpecialtyService

    SpecialtyService -> SpecialtyRepository : 11. UpdateSpecialtyAsync(updatedSpecialty)
    activate SpecialtyRepository
    SpecialtyRepository -> Database : 12. UpdateSpecialtyStatusData(id, newStatus)
    activate Database
    Database --> SpecialtyRepository : 13. Updated count
    deactivate Database
    SpecialtyRepository --> SpecialtyService : 14. SpecialtyEntity
    deactivate SpecialtyRepository

    alt Status update failed
        SpecialtyService --> SpecialtiesController : 15. Exception("Failed to toggle specialty status")
        deactivate SpecialtyService
        SpecialtiesController --> UI : 16. Return server error
        deactivate SpecialtiesController
        UI --> Admin : 17. Show "Failed to toggle status"
        deactivate UI
    else Status update successful
        SpecialtyService --> SpecialtiesController : 15. true
        deactivate SpecialtyService

        SpecialtiesController --> UI : 16. Return success
        deactivate SpecialtiesController

        UI --> Admin : 17. Show "Specialty status toggled successfully"
        deactivate UI
    end
end

@enduml
