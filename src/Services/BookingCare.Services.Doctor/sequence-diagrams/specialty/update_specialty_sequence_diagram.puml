@startuml
title Update Specialty

actor Admin
participant UI
participant SpecialtiesController
participant SpecialtyService
participant SpecialtyRepository
participant AutoMapper
database Database

== UI Request ==
Admin -> UI : 1. Edit specialty form and click "Update Specialty"
activate UI
UI -> SpecialtiesController : 2. HTTP PUT /api/specialties/{id} (UpdateSpecialtyRequest)
activate SpecialtiesController

== Service Call ==
SpecialtiesController -> SpecialtyService : 3. UpdateSpecialtyAsync(UpdateSpecialtyRequest)
activate SpecialtyService

== Validate Specialty Exists ==
SpecialtyService -> SpecialtyRepository : 4. GetSpecialtyByIdAsync(specialtyId)
activate SpecialtyRepository
SpecialtyRepository -> Database : 5. SELECT * FROM Specialties WHERE Id = @id
activate Database
Database --> SpecialtyRepository : 6. SpecialtyEntity
deactivate Database
SpecialtyRepository --> SpecialtyService : 7. SpecialtyEntity
deactivate SpecialtyRepository

alt Specialty not found
    SpecialtyService --> SpecialtiesController : 8. SpecialtyNotFoundException.WithId(specialtyId)
    deactivate SpecialtyService
    SpecialtiesController --> UI : 9. HTTP 404 Not Found
    deactivate SpecialtiesController
    UI --> Admin : 10. Show "Specialty not found"
    deactivate UI
else Specialty found

    == Validate Specialty Name (if changed) ==
    SpecialtyService -> SpecialtyRepository : 8. SpecialtyNameExistsAsync(name, excludeId)
    activate SpecialtyRepository
    SpecialtyRepository -> Database : 9. SELECT COUNT(*) FROM Specialties WHERE Name = @name AND Id != @excludeId
    activate Database
    Database --> SpecialtyRepository : 10. boolean exists
    deactivate Database
    SpecialtyRepository --> SpecialtyService : 11. boolean exists
    deactivate SpecialtyRepository

    alt Specialty name already exists
        SpecialtyService --> SpecialtiesController : 12. SpecialtyConflictException.WithName(name)
        deactivate SpecialtyService
        SpecialtiesController --> UI : 13. HTTP 409 Conflict
        deactivate SpecialtiesController
        UI --> Admin : 14. Show "Specialty name already exists"
        deactivate UI
    else Specialty name is unique
        note right: Continue to update specialty

        == Update Specialty Entity ==
        SpecialtyService -> AutoMapper : 15. Map(request, existingSpecialty)
        activate AutoMapper
        AutoMapper --> SpecialtyService : 16. Updated SpecialtyEntity
        deactivate AutoMapper

        SpecialtyService -> SpecialtyService : 17. Set UpdatedAt = DateTime.UtcNow
        activate SpecialtyService
        deactivate SpecialtyService

        == Save Updated Specialty ==
        SpecialtyService -> SpecialtyRepository : 18. UpdateSpecialtyAsync(updatedSpecialty)
        activate SpecialtyRepository
        SpecialtyRepository -> Database : 19. UPDATE Specialties SET Name = @name, Status = @status, UpdatedAt = @now WHERE Id = @id
        activate Database
        Database --> SpecialtyRepository : 20. Updated count
        deactivate Database
        SpecialtyRepository --> SpecialtyService : 21. SpecialtyEntity
        deactivate SpecialtyRepository

        == Map to Response DTO ==
        SpecialtyService -> AutoMapper : 22. Map(SpecialtyEntity → SpecialtyResponse)
        activate AutoMapper
        AutoMapper --> SpecialtyService : 23. SpecialtyResponse
        deactivate AutoMapper

        SpecialtyService --> SpecialtiesController : 24. SpecialtyResponse
        deactivate SpecialtyService

        SpecialtiesController --> UI : 25. HTTP 200 OK (SpecialtyResponse)
        deactivate SpecialtiesController

        UI --> Admin : 26. Show "Specialty updated successfully"
        deactivate UI
    end
end

@enduml
