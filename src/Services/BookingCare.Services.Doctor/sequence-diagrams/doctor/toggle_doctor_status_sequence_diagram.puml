@startuml
title Toggle Doctor Status

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Staff
participant UI
participant DoctorsController
participant DoctorService
participant DoctorRepository
participant AuthService
participant AutoMapper
database Database

Staff -> UI : 1. Click "Toggle Status" button on doctor
activate UI
UI -> DoctorsController : 2. ToggleDoctorStatus(id)
activate DoctorsController

DoctorsController -> DoctorService : 3. ToggleDoctorStatusAsync(Guid id)
activate DoctorService

DoctorService -> DoctorRepository : 4. GetDoctorByIdAsync(doctorId)
activate DoctorRepository
DoctorRepository -> Database : 5. GetDoctorDataById(id)
activate Database
Database --> DoctorRepository : 6. DoctorEntity (with includes)
deactivate Database
DoctorRepository --> DoctorService : 7. DoctorEntity
deactivate DoctorRepository

alt Doctor not found
    DoctorService --> DoctorsController : 8. DoctorNotFoundException.WithId(doctorId)
    deactivate DoctorService
    DoctorsController --> UI : 9. Return not found error
    deactivate DoctorsController
    UI --> Staff : 10. Show "Doctor not found"
    deactivate UI
else Doctor found

    DoctorService -> AuthService : 8. GetAccountStatusByIdAsync(accountId)
    activate AuthService
    AuthService -> Database : 9. GetAccountStatusData(accountId)
    activate Database
    Database --> AuthService : 10. AccountStatus
    deactivate Database
    AuthService --> DoctorService : 11. AccountStatus
    deactivate AuthService

    alt Current status is ACTIVE
        DoctorService -> AuthService : 12. UpdateAccountStatusAsync(accountId, INACTIVE)
        activate AuthService
        AuthService -> Database : 13. UpdateAccountStatusData(accountId, INACTIVE)
        activate Database
        Database --> AuthService : 14. Updated count
        deactivate Database
        AuthService --> DoctorService : 15. Success
        deactivate AuthService
    else Current status is INACTIVE
        DoctorService -> AuthService : 12. UpdateAccountStatusAsync(accountId, ACTIVE)
        activate AuthService
        AuthService -> Database : 13. UpdateAccountStatusData(accountId, ACTIVE)
        activate Database
        Database --> AuthService : 14. Updated count
        deactivate Database
        AuthService --> DoctorService : 15. Success
        deactivate AuthService
    end

    DoctorService -> AuthService : 16. GetAccountStatusByIdAsync(accountId)
    activate AuthService
    AuthService -> Database : 17. GetAccountStatusData(accountId)
    activate Database
    Database --> AuthService : 18. Updated AccountStatus
    deactivate Database
    AuthService --> DoctorService : 19. Updated AccountStatus
    deactivate AuthService

    alt Status update failed
        DoctorService --> DoctorsController : 20. Exception("Failed to toggle doctor status")
        deactivate DoctorService
        DoctorsController --> UI : 21. Return server error
        deactivate DoctorsController
        UI --> Staff : 22. Show "Failed to toggle status"
        deactivate UI
    else Status update successful
        DoctorService --> DoctorsController : 20. true
        deactivate DoctorService

        DoctorsController --> UI : 21. Return success
        deactivate DoctorsController

        UI --> Staff : 22. Show "Doctor status toggled successfully"
        deactivate UI
    end
end

@enduml
