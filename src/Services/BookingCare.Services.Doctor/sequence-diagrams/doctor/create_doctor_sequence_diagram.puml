@startuml
title Create Doctor

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Staff
participant UI
participant DoctorsController
participant DoctorService
participant DoctorRepository
participant PositionRepository
participant SpecialtyRepository
participant AutoMapper
database Database

Staff -> UI : 1. Fill doctor form and click "Create Doctor"
activate UI
UI -> DoctorsController : 2. CreateDoctor(CreateDoctorRequest)
activate DoctorsController

DoctorsController -> DoctorService : 3. CreateDoctorAsync(CreateDoctorRequest)
activate DoctorService

DoctorService -> DoctorService : 4. ValidateCreateDoctorRequest(request)
activate DoctorService

DoctorService -> DoctorRepository : 5. DoctorEmailExistsAsync(email)
activate DoctorRepository
DoctorRepository -> Database : 6. CheckDoctorEmailExists(email)
activate Database
Database --> DoctorRepository : 7. boolean exists
deactivate Database
DoctorRepository --> DoctorService : 8. boolean exists
deactivate DoctorRepository

alt Email already exists
    DoctorService --> DoctorsController : 9. DoctorConflictException.WithEmail(email)
    deactivate DoctorService
    DoctorsController --> UI : 10. Return conflict error
    deactivate DoctorsController
    UI --> Staff : 11. Show "Email already exists"
    deactivate UI
else Email is unique

    DoctorService -> DoctorRepository : 9. DoctorAccountExistsAsync(accountId)
    activate DoctorRepository
    DoctorRepository -> Database : 10. CheckDoctorAccountExists(accountId)
    activate Database
    Database --> DoctorRepository : 11. boolean exists
    deactivate Database
    DoctorRepository --> DoctorService : 12. boolean exists
    deactivate DoctorRepository

    alt Account already exists
        DoctorService --> DoctorsController : 13. DoctorConflictException.WithAccountId(accountId)
        deactivate DoctorService
        DoctorsController --> UI : 14. Return conflict error
        deactivate DoctorsController
        UI --> Staff : 15. Show "Account already exists"
        deactivate UI
    else Account is unique

        alt PositionId provided
            DoctorService -> PositionRepository : 13. PositionExistsAsync(positionId)
            activate PositionRepository
            PositionRepository -> Database : 14. CheckPositionExists(positionId)
            activate Database
            Database --> PositionRepository : 15. boolean exists
            deactivate Database
            PositionRepository --> DoctorService : 16. boolean exists
            deactivate PositionRepository

            alt Position not found
                DoctorService --> DoctorsController : 17. PositionNotFoundException.WithId(positionId)
                deactivate DoctorService
                DoctorsController --> UI : 18. Return not found error
                deactivate DoctorsController
                UI --> Staff: 19. Show "Position not found"
                deactivate UI
            else Position exists
                note right: Continue to next validation
            end
        end

        alt SpecialtyId provided
            DoctorService -> SpecialtyRepository : 17. SpecialtyExistsAsync(specialtyId)
            activate SpecialtyRepository
            SpecialtyRepository -> Database : 18. CheckSpecialtyExists(specialtyId)
            activate Database
            Database --> SpecialtyRepository : 19. boolean exists
            deactivate Database
            SpecialtyRepository --> DoctorService : 20. boolean exists
            deactivate SpecialtyRepository

            alt Specialty not found
                DoctorService --> DoctorsController : 21. ArgumentException("Specialty not found")
                deactivate DoctorService
                DoctorsController --> UI : 22. Return bad request error
                deactivate DoctorsController
                UI --> Staff: 23. Show "Specialty not found"
                deactivate UI
            else Specialty exists
                note right: Continue to create doctor
            end
        end

        DoctorService -> DoctorService : 21. CreateDoctorEntity(request)
        activate DoctorService
        DoctorService -> AutoMapper : 22. Map(CreateDoctorRequest → DoctorEntity)
        activate AutoMapper
        AutoMapper --> DoctorService : 23. DoctorEntity (with new Guid)
        deactivate AutoMapper
        deactivate DoctorService

        DoctorService -> DoctorRepository : 24. CreateDoctorAsync(doctor)
        activate DoctorRepository
        DoctorRepository -> Database : 25. CreateDoctorData(doctor)
        activate Database
        Database --> DoctorRepository : 26. DoctorEntity created
        deactivate Database
        DoctorRepository -> Database : 27. GetDoctorDataById(id)
        activate Database
        Database --> DoctorRepository : 28. DoctorEntity (with includes)
        deactivate Database
        DoctorRepository --> DoctorService : 29. DoctorEntity (with includes)
        deactivate DoctorRepository

        alt Prices provided
            DoctorService -> DoctorService : 30. CreateDoctorPricesAsync(doctorId, prices)
            activate DoctorService
            
            loop For each price
                DoctorService -> DoctorRepository : 31. GetServiceTypeByIdAsync(serviceTypeId)
                activate DoctorRepository
                DoctorRepository -> Database : 32. GetServiceTypeData(serviceTypeId)
                activate Database
                Database --> DoctorRepository : 33. ServiceTypeEntity
                deactivate Database
                DoctorRepository --> DoctorService : 34. ServiceTypeEntity
                deactivate DoctorRepository

                alt ServiceType not found
                    DoctorService --> DoctorsController : 35. ArgumentException("ServiceType not found")
                    deactivate DoctorService
                    DoctorsController --> UI : 36. Return bad request error
                    deactivate DoctorsController
                    UI --> Staff: 37. Show "ServiceType not found"
                    deactivate UI
                else ServiceType exists
                    DoctorService -> DoctorRepository : 35. CreateDoctorPriceAsync(doctorPrice)
                    activate DoctorRepository
                    DoctorRepository -> Database : 36. CreateDoctorPriceData(doctorPrice)
                    activate Database
                    Database --> DoctorRepository : 37. DoctorPriceEntity
                    deactivate Database
                    DoctorRepository --> DoctorService : 38. DoctorPriceEntity
                    deactivate DoctorRepository
                end
            end
            deactivate DoctorService
        end

        alt Languages provided
            DoctorService -> DoctorService : 39. CreateDoctorLanguagesAsync(doctorId, languageIds)
            activate DoctorService
            
            loop For each language
                DoctorService -> DoctorRepository : 40. GetLanguageByIdAsync(languageId)
                activate DoctorRepository
                DoctorRepository -> Database : 41. GetLanguageData(languageId)
                activate Database
                Database --> DoctorRepository : 42. LanguageEntity
                deactivate Database
                DoctorRepository --> DoctorService : 43. LanguageEntity
                deactivate DoctorRepository

                alt Language not found
                    DoctorService --> DoctorsController : 44. ArgumentException("Language not found")
                    deactivate DoctorService
                    DoctorsController --> UI : 45. Return bad request error
                    deactivate DoctorsController
                    UI --> Staff: 46. Show "Language not found"
                    deactivate UI
                else Language exists
                    DoctorService -> DoctorRepository : 44. CreateDoctorLanguageAsync(doctorLanguage)
                    activate DoctorRepository
                    DoctorRepository -> Database : 45. CreateDoctorLanguageData(doctorLanguage)
                    activate Database
                    Database --> DoctorRepository : 46. DoctorLanguageEntity
                    deactivate Database
                    DoctorRepository --> DoctorService : 47. DoctorLanguageEntity
                    deactivate DoctorRepository
                end
            end
            deactivate DoctorService
        end

        DoctorService -> AutoMapper : 48. Map(DoctorEntity → DoctorResponse)
        activate AutoMapper
        AutoMapper --> DoctorService : 49. DoctorResponse
        deactivate AutoMapper

        DoctorService --> DoctorsController : 50. DoctorResponse
        deactivate DoctorService

        DoctorsController --> UI : 51. Return DoctorResponse
        deactivate DoctorsController

        UI --> Staff: 52. Show "Doctor created successfully"
        deactivate UI
    end
end

@enduml