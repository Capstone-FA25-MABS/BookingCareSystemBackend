@startuml
title Get Doctor Detail

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor User
participant UI
participant DoctorsController
participant DoctorService
participant DoctorRepository
participant HospitalService
participant ReviewService
participant AutoMapper
database Database

User -> UI : 1. Click "View Doctor Details"
activate UI
UI -> DoctorsController : 2. GetDoctorDetail(id)
activate DoctorsController

DoctorsController -> DoctorService : 3. GetDoctorByIdAsync(Guid id)
activate DoctorService

DoctorService -> DoctorRepository : 4. GetDoctorByIdAsync(Guid id)
activate DoctorRepository
DoctorRepository -> Database : 5. GetDoctorDetailData(id)
activate Database
Database --> DoctorRepository : 6. DoctorEntity (with includes)
deactivate Database
DoctorRepository --> DoctorService : 7. DoctorEntity
deactivate DoctorRepository

alt Doctor not found
    DoctorService --> DoctorsController : 8. null
    deactivate DoctorService
    DoctorsController --> UI : 9. Return not found error
    deactivate DoctorsController
    UI --> User : 10. Show "Doctor not found"
    deactivate UI
else Doctor found

    DoctorService -> DoctorService : 8. IncludePositionAndSpecialtyAsync(doctor)
    activate DoctorService
    DoctorService -> DoctorRepository : 9. GetPositionByIdAsync(positionId)
    DoctorRepository -> Database : 10. GetPositionData(positionId)
    Database --> DoctorRepository : 11. PositionEntity
    DoctorRepository --> DoctorService : 12. PositionEntity
    
    DoctorService -> DoctorRepository : 13. GetSpecialtyByIdAsync(specialtyId)
    DoctorRepository -> Database : 14. GetSpecialtyData(specialtyId)
    Database --> DoctorRepository : 15. SpecialtyEntity
    DoctorRepository --> DoctorService : 16. SpecialtyEntity
    deactivate DoctorService

    DoctorService -> AutoMapper : 17. Map(DoctorEntity → DoctorByIdResponse)
    activate AutoMapper
    AutoMapper --> DoctorService : 18. DoctorByIdResponse
    deactivate AutoMapper

    par Hospital Info
        DoctorService -> HospitalService : 19. GetHospitalsBasicInfoAsync(GetHospitalsBasicInfoRequest)
        activate HospitalService
        alt HospitalService available
            HospitalService -> Database : 20. GetHospitalBasicData(hospitalId)
            activate Database
            Database --> HospitalService : 21. HospitalBasicInfo
            deactivate Database
            HospitalService --> DoctorService : 22. GetHospitalsBasicInfoResponse
        else HospitalService unavailable
            HospitalService --> DoctorService : 23. gRPC Error (Service Unavailable)
        end
        deactivate HospitalService
    else Review Statistics
        DoctorService -> ReviewService : 19. GetBatchDoctorsStatisticsAsync(BatchDoctorsStatisticsRequest)
        activate ReviewService
        alt ReviewService available
            ReviewService -> Database : 20. GetDoctorStatisticsData(doctorId)
            activate Database
            Database --> ReviewService : 21. DoctorStatistics
            deactivate Database
            ReviewService --> DoctorService : 22. BatchDoctorsStatisticsResponse
        else ReviewService unavailable
            ReviewService --> DoctorService : 23. gRPC Error (Service Unavailable)
        end
        deactivate ReviewService
    end

    DoctorService --> DoctorsController : 24. DoctorByIdResponse
    deactivate DoctorService

    DoctorsController --> UI : 25. Return DoctorByIdResponse
    deactivate DoctorsController

    UI --> User : 26. Render doctor detail page
    deactivate UI
end

@enduml
