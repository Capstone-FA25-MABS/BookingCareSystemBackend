@startuml
title Update Hospital

actor Staff
participant UI
participant HospitalsController
participant HospitalService
participant HospitalRepository
participant AuthService
participant AutoMapper
database Database

== UI Request ==
Staff -> UI : 1. Edit hospital form and click "Update Hospital"
activate UI
UI -> HospitalsController : 2. HTTP PUT /api/hospitals/{id} (UpdateHospitalRequest)
activate HospitalsController

== Service Call ==
HospitalsController -> HospitalService : 3. UpdateAsync(id, UpdateHospitalRequest)
activate HospitalService

== Validate Hospital Exists ==
HospitalService -> HospitalRepository : 4. GetByIdAsync(hospitalId)
activate HospitalRepository
HospitalRepository -> Database : 5. SELECT * FROM Hospitals WHERE Id = @id
activate Database
Database --> HospitalRepository : 6. HospitalEntity
deactivate Database
HospitalRepository --> HospitalService : 7. HospitalEntity
deactivate HospitalRepository

alt Hospital not found
    HospitalService --> HospitalsController : 8. HospitalNotFoundException(id)
    deactivate HospitalService
    HospitalsController --> UI : 9. HTTP 404 Not Found
    deactivate HospitalsController
    UI --> Staff : 10. Show "Hospital not found"
    deactivate UI
else Hospital found

    == Validate Hospital Email (if changed) ==
    alt Email is being updated
        HospitalService -> HospitalRepository : 8. EmailExistsAsync(email, excludeId)
        activate HospitalRepository
        HospitalRepository -> Database : 9. SELECT COUNT(*) FROM Hospitals WHERE Email = @email AND Id != @excludeId
        activate Database
        Database --> HospitalRepository : 10. boolean exists
        deactivate Database
        HospitalRepository --> HospitalService : 11. boolean exists
        deactivate HospitalRepository

        alt Hospital email already exists
            HospitalService --> HospitalsController : 12. HospitalAlreadyExistsException(email)
            deactivate HospitalService
            HospitalsController --> UI : 13. HTTP 409 Conflict
            deactivate HospitalsController
            UI --> Staff : 14. Show "Hospital email already exists"
            deactivate UI
        else Hospital email is unique
            note right: Continue to update hospital
        end
    end

    == Update Hospital Entity ==
    HospitalService -> AutoMapper : 15. Map(request, existingHospital)
    activate AutoMapper
    AutoMapper --> HospitalService : 16. Updated HospitalEntity
    deactivate AutoMapper

    == Save Updated Hospital ==
    HospitalService -> HospitalRepository : 17. UpdateAsync(updatedHospital)
    activate HospitalRepository
    HospitalRepository -> Database : 18. UPDATE Hospitals SET Name = @name, Email = @email, Address = @address, Phone = @phone, Description = @description, UpdatedAt = @now WHERE Id = @id
    activate Database
    Database --> HospitalRepository : 19. Updated count
    deactivate Database
    HospitalRepository --> HospitalService : 20. HospitalEntity
    deactivate HospitalRepository

    == Update Specialties (if provided) ==
    alt SpecialtyIds provided
        loop For each specialtyId
            HospitalService -> HospitalService : 21. AddSpecialtyAsync(hospitalId, specialtyId)
            activate HospitalService
            HospitalService -> Database : 22. INSERT INTO HospitalSpecialties (HospitalId, SpecialtyId)
            activate Database
            Database --> HospitalService : 23. Success
            deactivate Database
            deactivate HospitalService
        end
    end

    == Map to Response DTO ==
    HospitalService -> AutoMapper : 24. Map(HospitalEntity → HospitalResponse)
    activate AutoMapper
    AutoMapper --> HospitalService : 25. HospitalResponse
    deactivate AutoMapper

    == Enrich with Account Status ==
    HospitalService -> AuthService : 26. GetAccountStatusByIdsAsync([accountId])
    activate AuthService
    AuthService --> HospitalService : 27. Dictionary<Guid, Status>
    deactivate AuthService

    HospitalService -> HospitalService : 28. EnrichHospitalsWithStatusAsync([response])
    activate HospitalService
    deactivate HospitalService

    HospitalService --> HospitalsController : 29. HospitalResponse
    deactivate HospitalService

    HospitalsController --> UI : 30. HTTP 200 OK (HospitalResponse)
    deactivate HospitalsController

    UI --> Staff : 31. Show "Hospital updated successfully"
    deactivate UI
end

@enduml
