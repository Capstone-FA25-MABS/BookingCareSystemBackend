@startuml
title Create Hospital

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Admin
participant UI
participant HospitalsController
participant HospitalService
participant HospitalRepository
participant AuthService
participant AutoMapper
database Database

Admin -> UI : 1. Fill hospital form and click "Create Hospital"
activate UI
UI -> HospitalsController : 2. CreateHospital(CreateHospitalRequest)
activate HospitalsController

HospitalsController -> HospitalService : 3. CreateAsync(CreateHospitalRequest)
activate HospitalService

HospitalService -> HospitalRepository : 4. EmailExistsAsync(email)
activate HospitalRepository
HospitalRepository -> Database : 5. CheckHospitalEmailExists(email)
activate Database
Database --> HospitalRepository : 6. boolean exists
deactivate Database
HospitalRepository --> HospitalService : 7. boolean exists
deactivate HospitalRepository

alt Hospital email already exists
    HospitalService --> HospitalsController : 8. HospitalAlreadyExistsException(email)
    deactivate HospitalService
    HospitalsController --> UI : 9. Return conflict error
    deactivate HospitalsController
    UI --> Admin : 10. Show "Hospital email already exists"
    deactivate UI
else Hospital email is unique

    HospitalService -> AutoMapper : 8. Map(CreateHospitalRequest → HospitalEntity)
    activate AutoMapper
    AutoMapper --> HospitalService : 9. HospitalEntity
    deactivate AutoMapper

    HospitalService -> HospitalRepository : 10. CreateAsync(hospital)
    activate HospitalRepository
    HospitalRepository -> Database : 11. CreateHospitalData(hospital)
    activate Database
    Database --> HospitalRepository : 12. HospitalEntity created
    deactivate Database
    HospitalRepository --> HospitalService : 13. HospitalEntity
    deactivate HospitalRepository

    alt SpecialtyIds provided
        loop For each specialtyId
            HospitalService -> HospitalService : 14. AddSpecialtyAsync(hospitalId, specialtyId)
            activate HospitalService
            HospitalService -> Database : 15. CreateHospitalSpecialtyData(hospitalId, specialtyId)
            activate Database
            Database --> HospitalService : 16. Success
            deactivate Database
            deactivate HospitalService
        end
    end

    HospitalService -> HospitalRepository : 17. GetByIdAsync(hospitalId)
    activate HospitalRepository
    HospitalRepository -> Database : 18. GetHospitalDataWithSpecialties(id)
    activate Database
    Database --> HospitalRepository : 19. HospitalEntity with specialties
    deactivate Database
    HospitalRepository --> HospitalService : 20. HospitalEntity
    deactivate HospitalRepository

    HospitalService -> AutoMapper : 21. Map(HospitalEntity → HospitalDetailResponse)
    activate AutoMapper
    AutoMapper --> HospitalService : 22. HospitalDetailResponse
    deactivate AutoMapper

    HospitalService -> AuthService : 23. GetAccountStatusByIdsAsync([accountId])
    activate AuthService
    AuthService --> HospitalService : 24. Dictionary<Guid, Status>
    deactivate AuthService

    HospitalService -> HospitalService : 25. EnrichHospitalDetailWithStatusAsync(response)
    activate HospitalService
    deactivate HospitalService

    HospitalService --> HospitalsController : 26. HospitalDetailResponse
    deactivate HospitalService

    HospitalsController --> UI : 27. Return HospitalDetailResponse
    deactivate HospitalsController

    UI --> Admin : 28. Show "Hospital created successfully"
    deactivate UI
end

@enduml
