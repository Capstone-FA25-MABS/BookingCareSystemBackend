@startuml
title Toggle Hospital Status

skinparam backgroundColor White
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceActorBackgroundColor White
skinparam sequenceLifeLineBackgroundColor White
skinparam databaseBackgroundColor White
skinparam sequenceGroupBackgroundColor White

actor Staff
participant UI
participant HospitalsController
participant HospitalService
participant HospitalRepository
participant AuthService
participant AutoMapper
database Database

Staff -> UI : 1. Click "Toggle Status" button on hospital
activate UI
UI -> HospitalsController : 2. ToggleHospitalStatus(id)
activate HospitalsController

HospitalsController -> HospitalService : 3. ToggleHospitalStatusAsync(Guid id)
activate HospitalService

HospitalService -> HospitalRepository : 4. GetByIdAsync(hospitalId)
activate HospitalRepository
HospitalRepository -> Database : 5. GetHospitalDataById(id)
activate Database
Database --> HospitalRepository : 6. HospitalEntity
deactivate Database
HospitalRepository --> HospitalService : 7. HospitalEntity
deactivate HospitalRepository

alt Hospital not found
    HospitalService --> HospitalsController : 8. HospitalNotFoundException(id)
    deactivate HospitalService
    HospitalsController --> UI : 9. Return not found error
    deactivate HospitalsController
    UI --> Staff : 10. Show "Hospital not found"
    deactivate UI
else Hospital found

    HospitalService -> AuthService : 8. GetAccountStatusByIdsAsync([accountId])
    activate AuthService
    AuthService --> HospitalService : 9. Dictionary<Guid, Status>
    deactivate AuthService

    alt Current status is ACTIVE
        HospitalService -> AuthService : 10. UpdateAccountStatusAsync(accountId, INACTIVE)
        activate AuthService
        AuthService -> Database : 11. UpdateAccountStatusData(accountId, INACTIVE)
        activate Database
        Database --> AuthService : 12. Updated count
        deactivate Database
        AuthService --> HospitalService : 13. Success
        deactivate AuthService
    else Current status is INACTIVE
        HospitalService -> AuthService : 10. UpdateAccountStatusAsync(accountId, ACTIVE)
        activate AuthService
        AuthService -> Database : 11. UpdateAccountStatusData(accountId, ACTIVE)
        activate Database
        Database --> AuthService : 12. Updated count
        deactivate Database
        AuthService --> HospitalService : 13. Success
        deactivate AuthService
    end

    alt Status update failed
        HospitalService --> HospitalsController : 14. Exception("Failed to toggle hospital status")
        deactivate HospitalService
        HospitalsController --> UI : 15. Return server error
        deactivate HospitalsController
        UI --> Staff : 16. Show "Failed to toggle status"
        deactivate UI
    else Status update successful
        HospitalService --> HospitalsController : 14. true
        deactivate HospitalService

        HospitalsController --> UI : 15. Return success
        deactivate HospitalsController

        UI --> Staff : 16. Show "Hospital status toggled successfully"
        deactivate UI
    end
end

@enduml
