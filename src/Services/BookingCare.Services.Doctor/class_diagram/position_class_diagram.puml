@startuml
!theme plain
title Position Class Diagram - BookingCare.Services.Doctor

' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 2
}

skinparam arrow {
    Thickness 2
    Color Black
}

skinparam linetype ortho

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== ENTITIES =====
class BaseEntity {
    + public Guid Id
    + public string Name
    + public Status Status
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
}

class PositionEntity {
    + public string Name
    --
    [Table("positions")]
    [MaxLength(255)]
    [Column("name")]
}

' ===== REQUEST DTOs =====
class CreatePositionRequest {
    + public string Name
    + public Status Status
    --
    [Required]
    [StringLength(255, MinimumLength = 2)]
}

class UpdatePositionRequest {
    + public Guid Id
    + public string Name
    + public Status Status
    --
    [Required]
    [JsonRequired]
    [StringLength(255, MinimumLength = 2)]
}

class PositionQueryRequest {
    + public string? SearchTerm
    + public Status? Status
    + public int PageNumber
    + public int PageSize
    + public string? SortBy
    + public string? SortOrder
    --
    [JsonRequired]
}

' ===== RESPONSE DTOs =====
class PositionResponse {
    + public Guid Id
    + public string Name
    + public Status Status
    + public int DoctorCount
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
}

class PositionListResponse {
    + public List<PositionResponse> Positions
    + public int TotalCount
    + public int PageNumber
    + public int PageSize
    + public int TotalPages
}

class PositionSimpleResponse {
    + public Guid Id
    + public string Name
    + public int DoctorCount
    --
    Simple response DTO for performance optimization
}

' ===== REPOSITORY INTERFACE =====
interface IPositionRepository {
    + public GetPositionByIdAsync(Guid id) : Task<PositionEntity?>
    + public GetPositionByNameAsync(string name) : Task<PositionEntity?>
    + public CreatePositionAsync(PositionEntity position) : Task<PositionEntity>
    + public UpdatePositionAsync(PositionEntity position) : Task<PositionEntity>
    + public DeletePositionAsync(Guid id) : Task<bool>
    + public PositionExistsAsync(Guid id) : Task<bool>
    + public PositionNameExistsAsync(string name, Guid? excludeId) : Task<bool>
    + public GetPositionsAsync(PositionQueryRequest query) : Task<(List<PositionEntity>, int)>
    + public GetAllPositionsAsync() : Task<List<PositionEntity>>
    + public GetPositionsByIdsAsync(List<Guid> ids) : Task<List<PositionEntity>>
    + public GetDoctorCountsByPositionAsync() : Task<Dictionary<Guid, int>>
    + public GetActivePositionsSimpleAsync() : Task<List<PositionEntity>>
    + public GetActiveDoctorCountsByPositionAsync() : Task<Dictionary<Guid, int>>
}

' ===== REPOSITORY IMPLEMENTATION =====
class PositionRepository {
    - private DoctorDbContext _context
    --
    + public PositionRepository(DoctorDbContext context)
    + public GetPositionByIdAsync(Guid id) : Task<PositionEntity?>
    + public GetPositionByNameAsync(string name) : Task<PositionEntity?>
    + public CreatePositionAsync(PositionEntity position) : Task<PositionEntity>
    + public UpdatePositionAsync(PositionEntity position) : Task<PositionEntity>
    + public DeletePositionAsync(Guid id) : Task<bool>
    + public PositionExistsAsync(Guid id) : Task<bool>
    + public PositionNameExistsAsync(string name, Guid? excludeId) : Task<bool>
    + public GetPositionsAsync(PositionQueryRequest query) : Task<(List<PositionEntity>, int)>
    + public GetAllPositionsAsync() : Task<List<PositionEntity>>
    + public GetPositionsByIdsAsync(List<Guid> ids) : Task<List<PositionEntity>>
    + public GetDoctorCountsByPositionAsync() : Task<Dictionary<Guid, int>>
    + public GetActivePositionsSimpleAsync() : Task<List<PositionEntity>>
    + public GetActiveDoctorCountsByPositionAsync() : Task<Dictionary<Guid, int>>
    - private ApplySorting(IQueryable<PositionEntity> queryable, PositionQueryRequest query) : IQueryable<PositionEntity>
}

' ===== SERVICE INTERFACE =====
interface IPositionService {
    + public CreatePositionAsync(CreatePositionRequest request) : Task<PositionResponse>
    + public GetPositionByIdAsync(Guid id) : Task<PositionResponse?>
    + public GetPositionByNameAsync(string name) : Task<PositionResponse?>
    + public UpdatePositionAsync(UpdatePositionRequest request) : Task<PositionResponse>
    + public DeletePositionAsync(Guid id) : Task<bool>
    + public TogglePositionStatusAsync(Guid id) : Task<bool>
    + public GetPositionsAsync(PositionQueryRequest query) : Task<PositionListResponse>
    + public GetAllPositionsAsync() : Task<List<PositionResponse>>
    + public GetActivePositionsSimpleAsync() : Task<List<PositionSimpleResponse>>
    + public PositionExistsAsync(Guid id) : Task<bool>
    + public PositionNameExistsAsync(string name, Guid? excludeId) : Task<bool>
}

' ===== SERVICE IMPLEMENTATION =====
class PositionService {
    - private IPositionRepository _repository
    - private IMapper _mapper
    - private ILogger _logger
    --
    + public PositionService(IPositionRepository repository, IMapper mapper, ILogger logger)
    + public CreatePositionAsync(CreatePositionRequest request) : Task<PositionResponse>
    + public GetPositionByIdAsync(Guid id) : Task<PositionResponse?>
    + public GetPositionByNameAsync(string name) : Task<PositionResponse?>
    + public UpdatePositionAsync(UpdatePositionRequest request) : Task<PositionResponse>
    + public DeletePositionAsync(Guid id) : Task<bool>
    + public TogglePositionStatusAsync(Guid id) : Task<bool>
    + public GetPositionsAsync(PositionQueryRequest query) : Task<PositionListResponse>
    + public GetAllPositionsAsync() : Task<List<PositionResponse>>
    + public GetActivePositionsSimpleAsync() : Task<List<PositionSimpleResponse>>
    + public PositionExistsAsync(Guid id) : Task<bool>
    + public PositionNameExistsAsync(string name, Guid? excludeId) : Task<bool>
}

' ===== CONTROLLER =====
class PositionsController {
    - private IPositionService _positionService
    --
    + public PositionsController(IPositionService positionService)
    + public Health() : IActionResult
    + public GetPosition(Guid id) : Task<IActionResult>
    + public GetPositionByName(string name) : Task<IActionResult>
    + public GetPositions(PositionQueryRequest query) : Task<IActionResult>
    + public GetAllPositions() : Task<IActionResult>
    + public CreatePosition(CreatePositionRequest request) : Task<IActionResult>
    + public UpdatePosition(Guid id, UpdatePositionRequest request) : Task<IActionResult>
    + public DeletePosition(Guid id) : Task<IActionResult>
    + public TogglePositionStatus(Guid id) : Task<IActionResult>
    + public ValidatePositionName(string name, Guid? excludeId) : Task<IActionResult>
}

' ===== MAPPING PROFILE =====
class PositionMappingProfile {
    + public PositionMappingProfile()
    --
    AutoMapper profile for Position mappings
}

' ===== EXTERNAL DEPENDENCIES =====
class DoctorDbContext {
    + public DbSet<PositionEntity> Positions
    --
    Entity Framework DbContext
}

class AutoMapper.IMapper {
    + public Map<TSource, TDestination>(TSource source) : TDestination
    --
    AutoMapper interface
}

class ILogger {
    + public LogInformation(string message)
    + public LogError(Exception ex, string message)
    --
    .NET Core logging interface
}

' ===== ENUMS =====
enum Status {
    ACTIVE
    INACTIVE
}

' ===== LAYOUT POSITIONING =====
' Entities
BaseEntity -[hidden]- PositionEntity
PositionEntity -[hidden]- Status

' Request DTOs
CreatePositionRequest -[hidden]- UpdatePositionRequest
UpdatePositionRequest -[hidden]- PositionQueryRequest

' Response DTOs
PositionResponse -[hidden]- PositionListResponse
PositionListResponse -[hidden]- PositionSimpleResponse

' Repository Layer
IPositionRepository -[hidden]- PositionRepository
PositionRepository -[hidden]- DoctorDbContext

' Service Layer
IPositionService -[hidden]- PositionService
PositionService -[hidden]- IMapper
IMapper -[hidden]- ILogger

' Controller
PositionsController -[hidden]- PositionMappingProfile

' ===== RELATIONSHIPS =====
BaseEntity <|-- PositionEntity
IPositionRepository <|.. PositionRepository
IPositionService <|.. PositionService

PositionRepository --> DoctorDbContext
PositionRepository --> PositionEntity
PositionRepository --> PositionQueryRequest

PositionService --> IPositionRepository
PositionService --> IMapper
PositionService --> ILogger
PositionService --> CreatePositionRequest
PositionService --> UpdatePositionRequest
PositionService --> PositionQueryRequest
PositionService --> PositionResponse
PositionService --> PositionListResponse
PositionService --> PositionSimpleResponse

PositionsController --> IPositionService
PositionsController --> CreatePositionRequest
PositionsController --> UpdatePositionRequest
PositionsController --> PositionQueryRequest
PositionsController --> PositionResponse
PositionsController --> PositionListResponse
PositionsController --> PositionSimpleResponse

PositionMappingProfile --> PositionEntity
PositionMappingProfile --> CreatePositionRequest
PositionMappingProfile --> UpdatePositionRequest
PositionMappingProfile --> PositionResponse
PositionMappingProfile --> PositionListResponse

PositionEntity --> Status
CreatePositionRequest --> Status
UpdatePositionRequest --> Status
PositionResponse --> Status

@enduml
