@startuml
!theme plain
title Position Class Diagram
hide circle

' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 1
    FontSize 10
}

skinparam arrow {
    Thickness 1
    Color Black
}

skinparam linetype ortho
skinparam packageStyle rectangle

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== CORE ENTITIES =====
class PositionEntity {
    + Guid Id
    + string Name
    + Status Status
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

' ===== REQUEST DTOs =====
class CreatePositionRequest {
    + string Name
    + Status Status
}

class UpdatePositionRequest {
    + Guid Id
    + string Name
    + Status Status
}

class PositionQueryRequest {
    + string? SearchTerm
    + Status? Status
    + int PageNumber
    + int PageSize
}

' ===== RESPONSE DTOs =====
class PositionResponse {
    + Guid Id
    + string Name
    + Status Status
    + int DoctorCount
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

class PositionListResponse {
    + List<PositionResponse> Positions
    + int TotalCount
    + int PageNumber
    + int PageSize
    + int TotalPages
}

' ===== REPOSITORY INTERFACE =====
interface IPositionRepository {
    + GetPositionByIdAsync(Guid id) : Task<PositionEntity?>
    + GetPositionByNameAsync(string name) : Task<PositionEntity?>
    + CreatePositionAsync(PositionEntity position) : Task<PositionEntity>
    + UpdatePositionAsync(PositionEntity position) : Task<PositionEntity>
    + DeletePositionAsync(Guid id) : Task<bool>
    + GetPositionsAsync(PositionQueryRequest query) : Task<(List<PositionEntity>, int)>
    + GetAllPositionsAsync() : Task<List<PositionEntity>>
}

' ===== REPOSITORY IMPLEMENTATION =====
class PositionRepository {
    - DoctorDbContext _context
    --
    + PositionRepository(DoctorDbContext context)
    + GetPositionByIdAsync(Guid id) : Task<PositionEntity?>
    + GetPositionByNameAsync(string name) : Task<PositionEntity?>
    + CreatePositionAsync(PositionEntity position) : Task<PositionEntity>
    + UpdatePositionAsync(PositionEntity position) : Task<PositionEntity>
    + DeletePositionAsync(Guid id) : Task<bool>
    + GetPositionsAsync(PositionQueryRequest query) : Task<(List<PositionEntity>, int)>
    + GetAllPositionsAsync() : Task<List<PositionEntity>>
}

' ===== SERVICE INTERFACE =====
interface IPositionService {
    + CreatePositionAsync(CreatePositionRequest request) : Task<PositionResponse>
    + GetPositionByIdAsync(Guid id) : Task<PositionResponse?>
    + GetPositionByNameAsync(string name) : Task<PositionResponse?>
    + UpdatePositionAsync(UpdatePositionRequest request) : Task<PositionResponse>
    + DeletePositionAsync(Guid id) : Task<bool>
    + GetPositionsAsync(PositionQueryRequest query) : Task<PositionListResponse>
    + GetAllPositionsAsync() : Task<List<PositionResponse>>
}

' ===== SERVICE IMPLEMENTATION =====
class PositionService {
    - IPositionRepository _repository
    - IMapper _mapper
    - ILogger _logger
    --
    + PositionService(IPositionRepository repository, IMapper mapper, ILogger logger)
    + CreatePositionAsync(CreatePositionRequest request) : Task<PositionResponse>
    + GetPositionByIdAsync(Guid id) : Task<PositionResponse?>
    + GetPositionByNameAsync(string name) : Task<PositionResponse?>
    + UpdatePositionAsync(UpdatePositionRequest request) : Task<PositionResponse>
    + DeletePositionAsync(Guid id) : Task<bool>
    + GetPositionsAsync(PositionQueryRequest query) : Task<PositionListResponse>
    + GetAllPositionsAsync() : Task<List<PositionResponse>>
}

' ===== CONTROLLER =====
class PositionsController {
    - IPositionService _positionService
    --
    + PositionsController(IPositionService positionService)
    + GetPosition(Guid id) : Task<IActionResult>
    + GetPositionByName(string name) : Task<IActionResult>
    + GetPositions(PositionQueryRequest query) : Task<IActionResult>
    + GetAllPositions() : Task<IActionResult>
    + CreatePosition(CreatePositionRequest request) : Task<IActionResult>
    + UpdatePosition(Guid id, UpdatePositionRequest request) : Task<IActionResult>
    + DeletePosition(Guid id) : Task<IActionResult>
}

' ===== EXTERNAL DEPENDENCIES =====
class DoctorDbContext {
    + DbSet<PositionEntity> Positions
}

class AutoMapper.IMapper {
    + Map<TSource, TDestination>(TSource source) : TDestination
}

class ILogger {
    + LogInformation(string message)
    + LogError(Exception ex, string message)
}

' ===== ENUMS =====
enum Status {
    ACTIVE
    INACTIVE
}

' ===== LAYOUT POSITIONING =====
PositionEntity -[hidden]- CreatePositionRequest
CreatePositionRequest -[hidden]- UpdatePositionRequest
UpdatePositionRequest -[hidden]- PositionQueryRequest

PositionResponse -[hidden]- PositionListResponse

IPositionRepository -[hidden]- PositionRepository
PositionRepository -[hidden]- DoctorDbContext

IPositionService -[hidden]- PositionService
PositionService -[hidden]- PositionsController

IMapper -[hidden]- ILogger

' ===== RELATIONSHIPS =====
IPositionRepository <|.. PositionRepository
IPositionService <|.. PositionService

PositionRepository --> DoctorDbContext
PositionRepository --> PositionEntity
PositionRepository --> PositionQueryRequest

PositionService --> IPositionRepository
PositionService --> IMapper
PositionService --> ILogger
PositionService --> CreatePositionRequest
PositionService --> UpdatePositionRequest
PositionService --> PositionQueryRequest
PositionService --> PositionResponse
PositionService --> PositionListResponse

PositionsController --> IPositionService
PositionsController --> CreatePositionRequest
PositionsController --> UpdatePositionRequest
PositionsController --> PositionQueryRequest
PositionsController --> PositionResponse
PositionsController --> PositionListResponse

PositionEntity --> Status
CreatePositionRequest --> Status
UpdatePositionRequest --> Status
PositionQueryRequest --> Status
PositionResponse --> Status

@enduml