' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 2
}

skinparam arrow {
    Thickness 2
    Color Black
}

skinparam linetype ortho

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== ENTITIES =====
class DoctorDailyScheduleEntity {
    + public Guid Id
    + public Guid DoctorId
    + public DateOnly ScheduleDate
    + public List<SchedulePatterns> SchedulePatterns
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
    --
    [Table("doctor_daily_schedules")]
    [Required]
    [Column("doctor_id")]
    [Column("schedule_date")]
    [Column("schedule_patterns")]
}

class DoctorScheduleExceptionEntity {
    + public Guid Id
    + public Guid DoctorId
    + public DateOnly ExceptionDate
    + public AppointmentTime? AppointmentTime
    + public ExceptionType ExceptionType
    + public bool IsAvailable
    + public string? Reason
    + public DateTime CreatedAt
    --
    [Table("doctor_schedule_exceptions")]
    [Required]
    [StringLength(20)]
    [Column("exception_type")]
    [Column("is_available")]
    [StringLength(255)]
    [Column("reason")]
}

class ServiceScheduleEntity {
    + public Guid Id
    + public Guid ServiceId
    + public List<SchedulePatterns> SchedulePatterns
    + public Guid? ClinicId
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
    --
    [Table("service_schedules")]
    [Required]
    [Column("service_id")]
    [Column("schedule_patterns")]
    [Column("clinic_id")]
}

class ClinicExceptionEntity {
    + public Guid Id
    + public Guid ClinicId
    + public DateOnly ExceptionDate
    + public string? Reason
    --
    [Table("clinic_exceptions")]
    [Required]
    [StringLength(255)]
    [Column("reason")]
}

' ===== REQUEST DTOs =====
class CreateDoctorDailyScheduleRequest {
    + public Guid DoctorId
    + public DateOnly ScheduleDate
    + public List<SchedulePatterns> SchedulePatterns
    --
    [Required]
    [JsonRequired]
}

class CreateDoctorScheduleExceptionRequest {
    + public Guid DoctorId
    + public DateOnly ExceptionDate
    + public List<AppointmentTime>? AppointmentTimes
    + public ExceptionType ExceptionType
    + public bool IsAvailable
    + public string? Reason
    --
    [Required]
    [JsonRequired]
    [StringLength(255)]
}

class CreateClinicExceptionRequest {
    + public Guid ClinicId
    + public DateOnly ExceptionDate
    + public string? Reason
    --
    [Required]
    [StringLength(255)]
}

class CreateServiceScheduleRequest {
    + public Guid ServiceId
    + public List<SchedulePatterns> SchedulePatterns
    + public Guid? ClinicId
    --
    [Required]
}

class GetAvailableSlotsRequest {
    + public Guid DoctorId
    + public DateOnly Date
    + public Guid? ServiceId
    --
    [Required]
}

class GetDoctorScheduleRequest {
    + public Guid DoctorId
    + public DateOnly StartDate
    + public DateOnly EndDate
    --
    [Required]
}

class CreateAppointmentTimeRequest {
    + public string StartTime
    + public string EndTime
    --
    [Required]
    [RegularExpression(@"^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"]
}

