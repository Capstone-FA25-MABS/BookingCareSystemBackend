@startuml
!theme plain
title Schedule Class Diagram
hide circle

' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 1
    FontSize 10
}

skinparam arrow {
    Thickness 1
    Color Black
}

skinparam linetype ortho
skinparam packageStyle rectangle

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== CORE ENTITIES =====
class DoctorDailyScheduleEntity {
    + Guid Id
    + Guid DoctorId
    + DateOnly ScheduleDate
    + List<SchedulePatterns> SchedulePatterns
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

class DoctorScheduleExceptionEntity {
    + Guid Id
    + Guid DoctorId
    + DateOnly ExceptionDate
    + AppointmentTime? AppointmentTime
    + ExceptionType ExceptionType
    + bool IsAvailable
    + string? Reason
    + DateTime CreatedAt
}

' ===== REQUEST DTOs =====
class CreateDoctorDailyScheduleRequest {
    + Guid DoctorId
    + DateOnly ScheduleDate
    + List<SchedulePatterns> SchedulePatterns
}

class CreateDoctorScheduleExceptionRequest {
    + Guid DoctorId
    + DateOnly ExceptionDate
    + List<AppointmentTime>? AppointmentTimes
    + ExceptionType ExceptionType
    + bool IsAvailable
    + string? Reason
}

class GetAvailableSlotsRequest {
    + Guid DoctorId
    + DateOnly Date
    + Guid? ServiceId
}

class GetDoctorScheduleRequest {
    + Guid DoctorId
    + DateOnly StartDate
    + DateOnly EndDate
}

' ===== RESPONSE DTOs =====
class DoctorDailyScheduleDto {
    + Guid Id
    + Guid DoctorId
    + DateOnly ScheduleDate
    + List<SchedulePatterns> SchedulePatterns
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

class DoctorScheduleExceptionDto {
    + Guid Id
    + Guid DoctorId
    + DateOnly ExceptionDate
    + AppointmentTime? AppointmentTime
    + string ExceptionType
    + bool IsAvailable
    + string? Reason
    + DateTime CreatedAt
}

class AppointmentTimeDto {
    + Guid Id
    + string StartTime
    + string EndTime
}

' ===== REPOSITORY INTERFACE =====
interface IScheduleRepository {
    + GetDoctorDailyScheduleAsync(Guid doctorId, DateOnly date) : Task<DoctorDailyScheduleEntity?>
    + GetDoctorScheduleRangeAsync(Guid doctorId, DateOnly startDate, DateOnly endDate) : Task<IEnumerable<DoctorDailyScheduleEntity>>
    + CreateOrUpdateDoctorDailyScheduleAsync(DoctorDailyScheduleEntity schedule) : Task<DoctorDailyScheduleEntity>
    + DeleteDoctorDailyScheduleAsync(Guid doctorId, DateOnly date) : Task
    + GetDoctorExceptionsAsync(Guid doctorId, DateOnly date) : Task<IEnumerable<DoctorScheduleExceptionEntity>>
    + CreateDoctorScheduleExceptionAsync(DoctorScheduleExceptionEntity exception) : Task<DoctorScheduleExceptionEntity>
    + DeleteDoctorScheduleExceptionAsync(Guid id) : Task
    + GetAvailableSlotsAsync(Guid doctorId, DateOnly date, Guid? serviceId) : Task<IEnumerable<AppointmentTime>>
}

' ===== REPOSITORY IMPLEMENTATION =====
class ScheduleRepository {
    - ScheduleDbContext _context
    --
    + ScheduleRepository(ScheduleDbContext context)
    + GetDoctorDailyScheduleAsync(Guid doctorId, DateOnly date) : Task<DoctorDailyScheduleEntity?>
    + GetDoctorScheduleRangeAsync(Guid doctorId, DateOnly startDate, DateOnly endDate) : Task<IEnumerable<DoctorDailyScheduleEntity>>
    + CreateOrUpdateDoctorDailyScheduleAsync(DoctorDailyScheduleEntity schedule) : Task<DoctorDailyScheduleEntity>
    + DeleteDoctorDailyScheduleAsync(Guid doctorId, DateOnly date) : Task
    + GetDoctorExceptionsAsync(Guid doctorId, DateOnly date) : Task<IEnumerable<DoctorScheduleExceptionEntity>>
    + CreateDoctorScheduleExceptionAsync(DoctorScheduleExceptionEntity exception) : Task<DoctorScheduleExceptionEntity>
    + DeleteDoctorScheduleExceptionAsync(Guid id) : Task
    + GetAvailableSlotsAsync(Guid doctorId, DateOnly date, Guid? serviceId) : Task<IEnumerable<AppointmentTime>>
}

' ===== SERVICE INTERFACE =====
interface IScheduleService {
    + GetDoctorDailyScheduleAsync(Guid doctorId, DateOnly date) : Task<DoctorDailyScheduleDto?>
    + GetDoctorScheduleRangeAsync(GetDoctorScheduleRequest request) : Task<IEnumerable<DoctorDailyScheduleDto>>
    + CreateOrUpdateDoctorDailyScheduleAsync(CreateDoctorDailyScheduleRequest request) : Task<DoctorDailyScheduleDto>
    + DeleteDoctorDailyScheduleAsync(Guid doctorId, DateOnly date) : Task
    + GetDoctorExceptionsAsync(Guid doctorId, DateOnly date) : Task<IEnumerable<DoctorScheduleExceptionDto>>
    + CreateDoctorScheduleExceptionAsync(CreateDoctorScheduleExceptionRequest request) : Task<List<DoctorScheduleExceptionDto>>
    + DeleteDoctorScheduleExceptionAsync(Guid id) : Task
    + GetAvailableSlotsAsync(GetAvailableSlotsRequest request) : Task<IEnumerable<AppointmentTimeDto>>
}

' ===== SERVICE IMPLEMENTATION =====
class ScheduleService {
    - IScheduleRepository _repository
    - IMapper _mapper
    - ILogger _logger
    --
    + ScheduleService(IScheduleRepository repository, IMapper mapper, ILogger logger)
    + GetDoctorDailyScheduleAsync(Guid doctorId, DateOnly date) : Task<DoctorDailyScheduleDto?>
    + GetDoctorScheduleRangeAsync(GetDoctorScheduleRequest request) : Task<IEnumerable<DoctorDailyScheduleDto>>
    + CreateOrUpdateDoctorDailyScheduleAsync(CreateDoctorDailyScheduleRequest request) : Task<DoctorDailyScheduleDto>
    + DeleteDoctorDailyScheduleAsync(Guid doctorId, DateOnly date) : Task
    + GetDoctorExceptionsAsync(Guid doctorId, DateOnly date) : Task<IEnumerable<DoctorScheduleExceptionDto>>
    + CreateDoctorScheduleExceptionAsync(CreateDoctorScheduleExceptionRequest request) : Task<List<DoctorScheduleExceptionDto>>
    + DeleteDoctorScheduleExceptionAsync(Guid id) : Task
    + GetAvailableSlotsAsync(GetAvailableSlotsRequest request) : Task<IEnumerable<AppointmentTimeDto>>
}

' ===== CONTROLLER =====
class DoctorSchedulesController {
    - IScheduleService _scheduleService
    --
    + DoctorSchedulesController(IScheduleService scheduleService)
    + GetDoctorDailySchedule(Guid doctorId, DateOnly date) : Task<IActionResult>
    + GetDoctorScheduleRange(Guid doctorId, DateOnly startDate, DateOnly endDate) : Task<IActionResult>
    + CreateOrUpdateDoctorDailySchedule(CreateDoctorDailyScheduleRequest request) : Task<IActionResult>
    + DeleteDoctorDailySchedule(Guid doctorId, DateOnly date) : Task<IActionResult>
    + GetAvailableSlots(Guid doctorId, DateOnly date, Guid? serviceId) : Task<IActionResult>
}

' ===== EXTERNAL DEPENDENCIES =====
class ScheduleDbContext {
    + DbSet<DoctorDailyScheduleEntity> DoctorDailySchedules
    + DbSet<DoctorScheduleExceptionEntity> DoctorScheduleExceptions
}

class AutoMapper.IMapper {
    + Map<TSource, TDestination>(TSource source) : TDestination
}

class ILogger {
    + LogInformation(string message)
    + LogError(Exception ex, string message)
}

' ===== ENUMS =====
enum SchedulePatterns {
    MORNING
    AFTERNOON
    EVENING
    FULL_DAY
}

enum ExceptionType {
    BLOCK_SLOT
    UNBLOCK_SLOT
    DAY_OFF
    CAPACITY_CHANGE
}

enum AppointmentTime {
    AT_08_00_08_30
    AT_08_30_09_00
    AT_09_00_09_30
    AT_09_30_10_00
    AT_10_00_10_30
    AT_10_30_11_00
    AT_11_00_11_30
    AT_11_30_12_00
    AT_13_00_13_30
    AT_13_30_14_00
    AT_14_00_14_30
    AT_14_30_15_00
    AT_15_00_15_30
    AT_15_30_16_00
    AT_16_00_16_30
    AT_16_30_17_00
    AT_17_00_17_30
    AT_17_30_18_00
    AT_18_00_18_30
    AT_18_30_19_00
    AT_19_00_19_30
    AT_19_30_20_00
    AT_20_00_20_30
    AT_20_30_21_00
    AT_21_00_21_30
    AT_21_30_22_00
    AT_22_00_22_30
    AT_22_30_23_00
}

' ===== LAYOUT POSITIONING =====
DoctorDailyScheduleEntity -[hidden]- DoctorScheduleExceptionEntity

CreateDoctorDailyScheduleRequest -[hidden]- CreateDoctorScheduleExceptionRequest
CreateDoctorScheduleExceptionRequest -[hidden]- GetAvailableSlotsRequest
GetAvailableSlotsRequest -[hidden]- GetDoctorScheduleRequest

DoctorDailyScheduleDto -[hidden]- DoctorScheduleExceptionDto
DoctorScheduleExceptionDto -[hidden]- AppointmentTimeDto

IScheduleRepository -[hidden]- ScheduleRepository
ScheduleRepository -[hidden]- ScheduleDbContext

IScheduleService -[hidden]- ScheduleService
ScheduleService -[hidden]- DoctorSchedulesController

IMapper -[hidden]- ILogger

' ===== RELATIONSHIPS =====
IScheduleRepository <|.. ScheduleRepository
IScheduleService <|.. ScheduleService

ScheduleRepository --> ScheduleDbContext
ScheduleRepository --> DoctorDailyScheduleEntity
ScheduleRepository --> DoctorScheduleExceptionEntity
ScheduleRepository --> AppointmentTime

ScheduleService --> IScheduleRepository
ScheduleService --> IMapper
ScheduleService --> ILogger
ScheduleService --> CreateDoctorDailyScheduleRequest
ScheduleService --> CreateDoctorScheduleExceptionRequest
ScheduleService --> GetAvailableSlotsRequest
ScheduleService --> GetDoctorScheduleRequest
ScheduleService --> DoctorDailyScheduleDto
ScheduleService --> DoctorScheduleExceptionDto
ScheduleService --> AppointmentTimeDto

DoctorSchedulesController --> IScheduleService
DoctorSchedulesController --> CreateDoctorDailyScheduleRequest
DoctorSchedulesController --> GetAvailableSlotsRequest
DoctorSchedulesController --> GetDoctorScheduleRequest
DoctorSchedulesController --> DoctorDailyScheduleDto
DoctorSchedulesController --> AppointmentTimeDto

DoctorDailyScheduleEntity --> SchedulePatterns
DoctorScheduleExceptionEntity --> ExceptionType
DoctorScheduleExceptionEntity --> AppointmentTime
CreateDoctorDailyScheduleRequest --> SchedulePatterns
CreateDoctorScheduleExceptionRequest --> ExceptionType
CreateDoctorScheduleExceptionRequest --> AppointmentTime
DoctorDailyScheduleDto --> SchedulePatterns
DoctorScheduleExceptionDto --> AppointmentTime

@enduml