@startuml
!theme plain
title ServiceType Class Diagram
hide circle

' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 1
    FontSize 10
}

skinparam arrow {
    Thickness 1
    Color Black
}

skinparam linetype ortho
skinparam packageStyle rectangle

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== CORE ENTITIES =====
class ServiceTypeEntity {
    + Guid Id
    + string Name
    + string? Description
    + Status Status
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

' ===== REQUEST DTOs =====
class CreateServiceTypeRequest {
    + string Name
    + string? Description
    + Status Status
}

class UpdateServiceTypeRequest {
    + Guid Id
    + string Name
    + string? Description
    + Status Status
}

class ServiceTypeQueryRequest {
    + string? SearchTerm
    + Status? Status
    + int PageNumber
    + int PageSize
}

' ===== RESPONSE DTOs =====
class ServiceTypeResponse {
    + Guid Id
    + string Name
    + string? Description
    + Status Status
    + int DoctorCount
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

class ServiceTypeListResponse {
    + List<ServiceTypeResponse> ServiceTypes
    + int TotalCount
    + int PageNumber
    + int PageSize
    + int TotalPages
}

' ===== REPOSITORY INTERFACE =====
interface IServiceTypeRepository {
    + GetServiceTypeByIdAsync(Guid id) : Task<ServiceTypeEntity?>
    + GetServiceTypeByNameAsync(string name) : Task<ServiceTypeEntity?>
    + CreateServiceTypeAsync(ServiceTypeEntity serviceType) : Task<ServiceTypeEntity>
    + UpdateServiceTypeAsync(ServiceTypeEntity serviceType) : Task<ServiceTypeEntity>
    + DeleteServiceTypeAsync(Guid id) : Task<bool>
    + GetServiceTypesAsync(ServiceTypeQueryRequest query) : Task<(List<ServiceTypeEntity>, int)>
    + GetAllServiceTypesAsync() : Task<List<ServiceTypeEntity>>
}

' ===== REPOSITORY IMPLEMENTATION =====
class ServiceTypeRepository {
    - DoctorDbContext _context
    --
    + ServiceTypeRepository(DoctorDbContext context)
    + GetServiceTypeByIdAsync(Guid id) : Task<ServiceTypeEntity?>
    + GetServiceTypeByNameAsync(string name) : Task<ServiceTypeEntity?>
    + CreateServiceTypeAsync(ServiceTypeEntity serviceType) : Task<ServiceTypeEntity>
    + UpdateServiceTypeAsync(ServiceTypeEntity serviceType) : Task<ServiceTypeEntity>
    + DeleteServiceTypeAsync(Guid id) : Task<bool>
    + GetServiceTypesAsync(ServiceTypeQueryRequest query) : Task<(List<ServiceTypeEntity>, int)>
    + GetAllServiceTypesAsync() : Task<List<ServiceTypeEntity>>
}

' ===== SERVICE INTERFACE =====
interface IServiceTypeService {
    + CreateServiceTypeAsync(CreateServiceTypeRequest request) : Task<ServiceTypeResponse>
    + GetServiceTypeByIdAsync(Guid id) : Task<ServiceTypeResponse?>
    + GetServiceTypeByNameAsync(string name) : Task<ServiceTypeResponse?>
    + UpdateServiceTypeAsync(UpdateServiceTypeRequest request) : Task<ServiceTypeResponse>
    + DeleteServiceTypeAsync(Guid id) : Task<bool>
    + GetServiceTypesAsync(ServiceTypeQueryRequest query) : Task<ServiceTypeListResponse>
    + GetAllServiceTypesAsync() : Task<List<ServiceTypeResponse>>
}

' ===== SERVICE IMPLEMENTATION =====
class ServiceTypeService {
    - IServiceTypeRepository _repository
    - IMapper _mapper
    - ILogger _logger
    --
    + ServiceTypeService(IServiceTypeRepository repository, IMapper mapper, ILogger logger)
    + CreateServiceTypeAsync(CreateServiceTypeRequest request) : Task<ServiceTypeResponse>
    + GetServiceTypeByIdAsync(Guid id) : Task<ServiceTypeResponse?>
    + GetServiceTypeByNameAsync(string name) : Task<ServiceTypeResponse?>
    + UpdateServiceTypeAsync(UpdateServiceTypeRequest request) : Task<ServiceTypeResponse>
    + DeleteServiceTypeAsync(Guid id) : Task<bool>
    + GetServiceTypesAsync(ServiceTypeQueryRequest query) : Task<ServiceTypeListResponse>
    + GetAllServiceTypesAsync() : Task<List<ServiceTypeResponse>>
}

' ===== CONTROLLER =====
class ServiceTypesController {
    - IServiceTypeService _serviceTypeService
    --
    + ServiceTypesController(IServiceTypeService serviceTypeService)
    + GetServiceType(Guid id) : Task<IActionResult>
    + GetServiceTypeByName(string name) : Task<IActionResult>
    + GetServiceTypes(ServiceTypeQueryRequest query) : Task<IActionResult>
    + GetAllServiceTypes() : Task<IActionResult>
    + CreateServiceType(CreateServiceTypeRequest request) : Task<IActionResult>
    + UpdateServiceType(Guid id, UpdateServiceTypeRequest request) : Task<IActionResult>
    + DeleteServiceType(Guid id) : Task<IActionResult>
}

' ===== EXTERNAL DEPENDENCIES =====
class DoctorDbContext {
    + DbSet<ServiceTypeEntity> ServiceTypes
}

class AutoMapper.IMapper {
    + Map<TSource, TDestination>(TSource source) : TDestination
}

class ILogger {
    + LogInformation(string message)
    + LogError(Exception ex, string message)
}

' ===== ENUMS =====
enum Status {
    ACTIVE
    INACTIVE
}

' ===== LAYOUT POSITIONING =====
ServiceTypeEntity -[hidden]- CreateServiceTypeRequest
CreateServiceTypeRequest -[hidden]- UpdateServiceTypeRequest
UpdateServiceTypeRequest -[hidden]- ServiceTypeQueryRequest

ServiceTypeResponse -[hidden]- ServiceTypeListResponse

IServiceTypeRepository -[hidden]- ServiceTypeRepository
ServiceTypeRepository -[hidden]- DoctorDbContext

IServiceTypeService -[hidden]- ServiceTypeService
ServiceTypeService -[hidden]- ServiceTypesController

IMapper -[hidden]- ILogger

' ===== RELATIONSHIPS =====
IServiceTypeRepository <|.. ServiceTypeRepository
IServiceTypeService <|.. ServiceTypeService

ServiceTypeRepository --> DoctorDbContext
ServiceTypeRepository --> ServiceTypeEntity
ServiceTypeRepository --> ServiceTypeQueryRequest

ServiceTypeService --> IServiceTypeRepository
ServiceTypeService --> IMapper
ServiceTypeService --> ILogger
ServiceTypeService --> CreateServiceTypeRequest
ServiceTypeService --> UpdateServiceTypeRequest
ServiceTypeService --> ServiceTypeQueryRequest
ServiceTypeService --> ServiceTypeResponse
ServiceTypeService --> ServiceTypeListResponse

ServiceTypesController --> IServiceTypeService
ServiceTypesController --> CreateServiceTypeRequest
ServiceTypesController --> UpdateServiceTypeRequest
ServiceTypesController --> ServiceTypeQueryRequest
ServiceTypesController --> ServiceTypeResponse
ServiceTypesController --> ServiceTypeListResponse

ServiceTypeEntity --> Status
CreateServiceTypeRequest --> Status
UpdateServiceTypeRequest --> Status
ServiceTypeQueryRequest --> Status
ServiceTypeResponse --> Status

@enduml