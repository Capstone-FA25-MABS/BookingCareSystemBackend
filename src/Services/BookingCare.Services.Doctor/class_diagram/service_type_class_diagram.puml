' ===== ENTITIES =====
class BaseEntity {
    + public Guid Id
    + public string Name
    + public Status Status
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
}

class ServiceTypeEntity {
    + public string Name
    + public string? Description
    --
    [Table("doctor_service_types")]
    [MaxLength(100)]
    [Column("name")]
    [MaxLength(255)]
    [Column("description")]
}

' ===== REQUEST DTOs =====
class CreateServiceTypeRequest {
    + public string Name
    + public string? Description
    + public Status Status
    --
    [Required]
    [StringLength(100, MinimumLength = 2)]
    [StringLength(255)]
}

class UpdateServiceTypeRequest {
    + public Guid Id
    + public string Name
    + public string? Description
    + public Status Status
    --
    [Required]
    [JsonRequired]
    [StringLength(100, MinimumLength = 2)]
    [StringLength(255)]
}

class ServiceTypeQueryRequest {
    + public string? SearchTerm
    + public Status? Status
    + public int PageNumber
    + public int PageSize
    + public string? SortBy
    + public string? SortOrder
    --
    [JsonRequired]
}

