@startuml
!theme plain
title Hospital Class Diagram
hide circle

' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 1
    FontSize 10
}

skinparam arrow {
    Thickness 1
    Color Black
}

skinparam linetype ortho
skinparam packageStyle rectangle

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== CORE ENTITIES =====
class HospitalEntity {
    + Guid Id
    + Guid AccountId
    + string Name
    + string Address
    + string? Phone
    + string Email
    + string Description
    + string? AvatarUrl
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

' ===== REQUEST DTOs =====
class CreateHospitalRequest {
    + Guid AccountId
    + string Name
    + string Address
    + string? Phone
    + string Email
    + string Description
    + string? AvatarUrl
}

class UpdateHospitalRequest {
    + string Name
    + string Address
    + string? Phone
    + string Email
    + string Description
    + string? AvatarUrl
}

class HospitalFilterRequest {
    + string? SearchTerm
    + Guid? SpecialtyId
    + int PageNumber
    + int PageSize
}

' ===== RESPONSE DTOs =====
class HospitalResponse {
    + Guid Id
    + string Name
    + string Address
    + string? Phone
    + string Email
    + string Description
    + string? AvatarUrl
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

class HospitalListResponse {
    + List<HospitalResponse> Hospitals
    + int TotalCount
    + int PageNumber
    + int PageSize
    + int TotalPages
}

' ===== REPOSITORY INTERFACE =====
interface IHospitalRepository {
    + GetByIdAsync(Guid id) : Task<HospitalEntity?>
    + GetByEmailAsync(string email) : Task<HospitalEntity?>
    + GetAllAsync() : Task<List<HospitalEntity>>
    + GetFilteredAsync(HospitalFilterRequest filter) : Task<(List<HospitalEntity>, int)>
    + CreateAsync(HospitalEntity hospital) : Task<HospitalEntity>
    + UpdateAsync(HospitalEntity hospital) : Task<HospitalEntity>
    + DeleteAsync(Guid id) : Task<bool>
}

' ===== REPOSITORY IMPLEMENTATION =====
class HospitalRepository {
    - HospitalDbContext _context
    --
    + HospitalRepository(HospitalDbContext context)
    + GetByIdAsync(Guid id) : Task<HospitalEntity?>
    + GetByEmailAsync(string email) : Task<HospitalEntity?>
    + GetAllAsync() : Task<List<HospitalEntity>>
    + GetFilteredAsync(HospitalFilterRequest filter) : Task<(List<HospitalEntity>, int)>
    + CreateAsync(HospitalEntity hospital) : Task<HospitalEntity>
    + UpdateAsync(HospitalEntity hospital) : Task<HospitalEntity>
    + DeleteAsync(Guid id) : Task<bool>
}

' ===== SERVICE INTERFACE =====
interface IHospitalService {
    + GetByIdAsync(Guid id) : Task<HospitalResponse?>
    + GetByEmailAsync(string email) : Task<HospitalResponse?>
    + GetAllAsync() : Task<HospitalListResponse>
    + GetFilteredAsync(HospitalFilterRequest filter) : Task<HospitalListResponse>
    + CreateAsync(CreateHospitalRequest request) : Task<HospitalResponse>
    + UpdateAsync(Guid id, UpdateHospitalRequest request) : Task<HospitalResponse>
    + DeleteAsync(Guid id) : Task<bool>
}

' ===== SERVICE IMPLEMENTATION =====
class HospitalService {
    - IHospitalRepository _repository
    - IMapper _mapper
    - ILogger _logger
    --
    + HospitalService(IHospitalRepository repository, IMapper mapper, ILogger logger)
    + GetByIdAsync(Guid id) : Task<HospitalResponse?>
    + GetByEmailAsync(string email) : Task<HospitalResponse?>
    + GetAllAsync() : Task<HospitalListResponse>
    + GetFilteredAsync(HospitalFilterRequest filter) : Task<HospitalListResponse>
    + CreateAsync(CreateHospitalRequest request) : Task<HospitalResponse>
    + UpdateAsync(Guid id, UpdateHospitalRequest request) : Task<HospitalResponse>
    + DeleteAsync(Guid id) : Task<bool>
}

' ===== CONTROLLER =====
class HospitalsController {
    - IHospitalService _hospitalService
    --
    + HospitalsController(IHospitalService hospitalService)
    + GetHospital(Guid id) : Task<IActionResult>
    + GetHospitalByEmail(string email) : Task<IActionResult>
    + GetHospitals(HospitalFilterRequest filter) : Task<IActionResult>
    + GetAllHospitals() : Task<IActionResult>
    + CreateHospital(CreateHospitalRequest request) : Task<IActionResult>
    + UpdateHospital(Guid id, UpdateHospitalRequest request) : Task<IActionResult>
    + DeleteHospital(Guid id) : Task<IActionResult>
}

' ===== EXTERNAL DEPENDENCIES =====
class HospitalDbContext {
    + DbSet<HospitalEntity> Hospitals
}

class AutoMapper.IMapper {
    + Map<TSource, TDestination>(TSource source) : TDestination
}

class ILogger {
    + LogInformation(string message)
    + LogError(Exception ex, string message)
}

' ===== LAYOUT POSITIONING =====
HospitalEntity -[hidden]- CreateHospitalRequest
CreateHospitalRequest -[hidden]- UpdateHospitalRequest
UpdateHospitalRequest -[hidden]- HospitalFilterRequest

HospitalResponse -[hidden]- HospitalListResponse

IHospitalRepository -[hidden]- HospitalRepository
HospitalRepository -[hidden]- HospitalDbContext

IHospitalService -[hidden]- HospitalService
HospitalService -[hidden]- HospitalsController

IMapper -[hidden]- ILogger

' ===== RELATIONSHIPS =====
IHospitalRepository <|.. HospitalRepository
IHospitalService <|.. HospitalService

HospitalRepository --> HospitalDbContext
HospitalRepository --> HospitalEntity
HospitalRepository --> HospitalFilterRequest

HospitalService --> IHospitalRepository
HospitalService --> IMapper
HospitalService --> ILogger
HospitalService --> CreateHospitalRequest
HospitalService --> UpdateHospitalRequest
HospitalService --> HospitalFilterRequest
HospitalService --> HospitalResponse
HospitalService --> HospitalListResponse

HospitalsController --> IHospitalService
HospitalsController --> CreateHospitalRequest
HospitalsController --> UpdateHospitalRequest
HospitalsController --> HospitalFilterRequest
HospitalsController --> HospitalResponse
HospitalsController --> HospitalListResponse

@enduml