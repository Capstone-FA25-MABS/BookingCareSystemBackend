@startuml
!theme plain
title Hospital Class Diagram - BookingCare.Services.Hospital

' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 2
}

skinparam arrow {
    Thickness 2
    Color Black
}

skinparam linetype ortho

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== ENTITIES =====
class HospitalEntity {
    + public Guid Id
    + public Guid AccountId
    + public string Name
    + public string Address
    + public string? Phone
    + public string Email
    + public string Description
    + public string? BackgroundUrl
    + public string? AvatarUrl
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
    --
    [Table("hospitals")]
    [MaxLength(255)]
    [Column("name")]
    [MaxLength(20)]
    [Column("phone")]
    [MaxLength(100)]
    [Column("email")]
}

class HospitalSubscriptionEntity {
    + public Guid HospitalSubscriptionId
    + public Guid HospitalId
    + public Guid SubscriptionId
    + public DateTime StartDate
    + public DateTime EndDate
    + public SubscriptionStatus Status
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
    --
    [Table("hospital_subscriptions")]
    [Column("hospital_subscription_id")]
}

class HospitalSpecialtyEntity {
    + public Guid HospitalId
    + public Guid SpecialtyId
    --
    [Table("hospital_specialties")]
    [Key, Column("hospital_id", Order = 0)]
    [Key, Column("specialty_id", Order = 1)]
}

class HospitalImageEntity {
    + public Guid Id
    + public Guid HospitalId
    + public string S3Key
    + public string ImageUrl
    + public string? Description
    + public DateTime CreatedAt
    --
    [Table("hospital_images")]
    [MaxLength(500)]
    [Column("s3_key")]
    [MaxLength(255)]
    [Column("description")]
}

' ===== REQUEST DTOs =====
class CreateHospitalRequest {
    + public Guid AccountId
    + public string Name
    + public string Address
    + public string? Phone
    + public string Email
    + public string Description
    + public string? BackgroundUrl
    + public string? AvatarUrl
    + public List<Guid> SpecialtyIds
    --
    [Required]
    [StringLength(255, MinimumLength = 2)]
    [Required]
    [Phone]
    [Required]
    [EmailAddress]
    [StringLength(100)]
    [Required]
    [Url]
    [Url]
}

class UpdateHospitalRequest {
    + public string Name
    + public string Address
    + public string? Phone
    + public string Email
    + public string Description
    + public string? BackgroundUrl
    + public string? AvatarUrl
    + public List<Guid> SpecialtyIds
    --
    [Required]
    [StringLength(255, MinimumLength = 2)]
    [Required]
    [Phone]
    [Required]
    [EmailAddress]
    [StringLength(100)]
    [Required]
    [Url]
    [Url]
}

class HospitalFilterRequest {
    + public string? SearchTerm
    + public Guid? SpecialtyId
    + public int PageNumber
    + public int PageSize
    + public string? SortBy
    + public string? SortOrder
    --
    [JsonRequired]
}

' ===== RESPONSE DTOs =====
class HospitalResponse {
    + public Guid Id
    + public Guid AccountId
    + public string Name
    + public string Address
    + public string? Phone
    + public string Email
    + public string Description
    + public string? BackgroundUrl
    + public string? AvatarUrl
    + public List<SpecialtyResponse> Specialties
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
}

class HospitalDetailResponse {
    + public Guid Id
    + public Guid AccountId
    + public string Name
    + public string Address
    + public string? Phone
    + public string Email
    + public string Description
    + public string? BackgroundUrl
    + public string? AvatarUrl
    + public List<SpecialtyResponse> Specialties
    + public List<PositionResponse> Positions
    + public List<ServiceTypeResponse> ServiceTypes
    + public int DoctorCount
    + public List<HospitalImageResponse> Images
    + public HospitalSubscriptionResponse? ActiveSubscription
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
}

class HospitalListResponse {
    + public List<HospitalResponse> Hospitals
    + public int TotalCount
    + public int PageNumber
    + public int PageSize
    + public int TotalPages
}

class HospitalSimpleResponse {
    + public Guid Id
    + public string Name
    + public string Address
    + public string? Phone
    + public string Email
    + public string? AvatarUrl
    --
    Simple response DTO for performance optimization
}

class HospitalImageResponse {
    + public Guid Id
    + public string S3Key
    + public string ImageUrl
    + public string? Description
    + public DateTime CreatedAt
}

class HospitalSubscriptionResponse {
    + public Guid HospitalSubscriptionId
    + public Guid SubscriptionId
    + public string SubscriptionName
    + public DateTime StartDate
    + public DateTime EndDate
    + public SubscriptionStatus Status
}

class SpecialtyResponse {
    + public Guid Id
    + public string Name
    + public string ImageUrl
}

class PositionResponse {
    + public Guid Id
    + public string Name
    + public int DoctorCount
}

class ServiceTypeResponse {
    + public Guid Id
    + public string Name
    + public string? Description
    + public int DoctorCount
}

' ===== REPOSITORY INTERFACE =====
interface IHospitalRepository {
    + public GetByIdAsync(Guid id) : Task<HospitalEntity?>
    + public GetByEmailAsync(string email) : Task<HospitalEntity?>
    + public GetAllAsync() : Task<List<HospitalEntity>>
    + public GetFilteredAsync(HospitalFilterRequest filter) : Task<(List<HospitalEntity>, int)>
    + public CreateAsync(HospitalEntity hospital) : Task<HospitalEntity>
    + public UpdateAsync(HospitalEntity hospital) : Task<HospitalEntity>
    + public DeleteAsync(Guid id) : Task<bool>
    + public ExistsAsync(Guid id) : Task<bool>
    + public EmailExistsAsync(string email, Guid? excludeId) : Task<bool>
    + public GetBySpecialtyAsync(Guid specialtyId) : Task<List<HospitalEntity>>
    + public GetByAccountIdAsync(Guid accountId) : Task<List<HospitalEntity>>
    + public GetHospitalBasicInfoByIdAsync(Guid id) : Task<HospitalEntity?>
    + public GetHospitalsBasicInfoByIdsAsync(IEnumerable<Guid> ids) : Task<List<HospitalEntity>>
    + public GetActiveHospitalsSimpleAsync() : Task<List<HospitalEntity>>
}

' ===== REPOSITORY IMPLEMENTATION =====
class HospitalRepository {
    - private HospitalDbContext _context
    --
    + public HospitalRepository(HospitalDbContext context)
    + public GetByIdAsync(Guid id) : Task<HospitalEntity?>
    + public GetByEmailAsync(string email) : Task<HospitalEntity?>
    + public GetAllAsync() : Task<List<HospitalEntity>>
    + public GetFilteredAsync(HospitalFilterRequest filter) : Task<(List<HospitalEntity>, int)>
    + public CreateAsync(HospitalEntity hospital) : Task<HospitalEntity>
    + public UpdateAsync(HospitalEntity hospital) : Task<HospitalEntity>
    + public DeleteAsync(Guid id) : Task<bool>
    + public ExistsAsync(Guid id) : Task<bool>
    + public EmailExistsAsync(string email, Guid? excludeId) : Task<bool>
    + public GetBySpecialtyAsync(Guid specialtyId) : Task<List<HospitalEntity>>
    + public GetByAccountIdAsync(Guid accountId) : Task<List<HospitalEntity>>
    + public GetHospitalBasicInfoByIdAsync(Guid id) : Task<HospitalEntity?>
    + public GetHospitalsBasicInfoByIdsAsync(IEnumerable<Guid> ids) : Task<List<HospitalEntity>>
    + public GetActiveHospitalsSimpleAsync() : Task<List<HospitalEntity>>
    - private ApplySorting(IQueryable<HospitalEntity> queryable, HospitalFilterRequest filter) : IQueryable<HospitalEntity>
}

' ===== SERVICE INTERFACE =====
interface IHospitalService {
    + public GetByIdAsync(Guid id) : Task<HospitalDetailResponse?>
    + public GetByEmailAsync(string email) : Task<HospitalResponse?>
    + public GetAllAsync() : Task<HospitalListResponse>
    + public GetFilteredAsync(HospitalFilterRequest filter) : Task<HospitalListResponse>
    + public CreateAsync(CreateHospitalRequest request) : Task<HospitalDetailResponse>
    + public UpdateAsync(Guid id, UpdateHospitalRequest request) : Task<HospitalResponse>
    + public DeleteAsync(Guid id) : Task<bool>
    + public GetBySpecialtyAsync(Guid specialtyId) : Task<List<HospitalResponse>>
    + public GetByAccountIdAsync(Guid accountId) : Task<List<HospitalResponse>>
    + public AddSpecialtyAsync(Guid hospitalId, Guid specialtyId) : Task<bool>
    + public RemoveSpecialtyAsync(Guid hospitalId, Guid specialtyId) : Task<bool>
    + public GetHospitalBasicInfoByIdAsync(Guid id) : Task<HospitalEntity?>
    + public GetHospitalsBasicInfoByIdsAsync(IEnumerable<Guid> ids) : Task<List<HospitalEntity>>
    + public GetActiveHospitalsSimpleAsync() : Task<List<HospitalSimpleResponse>>
}

' ===== SERVICE IMPLEMENTATION =====
class HospitalService {
    - private IHospitalRepository _repository
    - private IMapper _mapper
    - private ILogger _logger
    - private IAuthService _authService
    - private IDoctorService _doctorService
    --
    + public HospitalService(IHospitalRepository repository, IMapper mapper, ILogger logger, IAuthService authService, IDoctorService doctorService)
    + public GetByIdAsync(Guid id) : Task<HospitalDetailResponse?>
    + public GetByEmailAsync(string email) : Task<HospitalResponse?>
    + public GetAllAsync() : Task<HospitalListResponse>
    + public GetFilteredAsync(HospitalFilterRequest filter) : Task<HospitalListResponse>
    + public CreateAsync(CreateHospitalRequest request) : Task<HospitalDetailResponse>
    + public UpdateAsync(Guid id, UpdateHospitalRequest request) : Task<HospitalResponse>
    + public DeleteAsync(Guid id) : Task<bool>
    + public GetBySpecialtyAsync(Guid specialtyId) : Task<List<HospitalResponse>>
    + public GetByAccountIdAsync(Guid accountId) : Task<List<HospitalResponse>>
    + public AddSpecialtyAsync(Guid hospitalId, Guid specialtyId) : Task<bool>
    + public RemoveSpecialtyAsync(Guid hospitalId, Guid specialtyId) : Task<bool>
    + public GetHospitalBasicInfoByIdAsync(Guid id) : Task<HospitalEntity?>
    + public GetHospitalsBasicInfoByIdsAsync(IEnumerable<Guid> ids) : Task<List<HospitalEntity>>
    + public GetActiveHospitalsSimpleAsync() : Task<List<HospitalSimpleResponse>>
    - private ValidateCreateHospitalRequest(CreateHospitalRequest request) : Task
    - private ValidateUpdateHospitalRequest(UpdateHospitalRequest request) : Task
    - private CreateHospitalEntity(CreateHospitalRequest request) : HospitalEntity
    - private UpdateHospitalEntity(HospitalEntity existingHospital, UpdateHospitalRequest request) : HospitalEntity
    - private CreateHospitalSpecialtiesAsync(Guid hospitalId, List<Guid> specialtyIds) : Task
    - private UpdateHospitalSpecialtiesAsync(Guid hospitalId, List<Guid> specialtyIds) : Task
    - private EnrichHospitalWithSpecialtiesAsync(HospitalEntity hospital) : Task
    - private EnrichHospitalDetailWithDoctorInfoAsync(HospitalEntity hospital) : Task
    - private EnrichHospitalDetailWithImagesAsync(HospitalEntity hospital) : Task
    - private EnrichHospitalDetailWithSubscriptionAsync(HospitalEntity hospital) : Task
}

' ===== CONTROLLER =====
class HospitalsController {
    - private IHospitalService _hospitalService
    --
    + public HospitalsController(IHospitalService hospitalService)
    + public Health() : IActionResult
    + public GetHospital(Guid id) : Task<IActionResult>
    + public GetHospitalByEmail(string email) : Task<IActionResult>
    + public GetHospitals(HospitalFilterRequest filter) : Task<IActionResult>
    + public GetAllHospitals() : Task<IActionResult>
    + public GetHospitalsBySpecialty(Guid specialtyId) : Task<IActionResult>
    + public GetHospitalsByAccountId(Guid accountId) : Task<IActionResult>
    + public CreateHospital(CreateHospitalRequest request) : Task<IActionResult>
    + public UpdateHospital(Guid id, UpdateHospitalRequest request) : Task<IActionResult>
    + public DeleteHospital(Guid id) : Task<IActionResult>
    + public AddSpecialtyToHospital(Guid hospitalId, Guid specialtyId) : Task<IActionResult>
    + public RemoveSpecialtyFromHospital(Guid hospitalId, Guid specialtyId) : Task<IActionResult>
    + public ValidateHospitalEmail(string email, Guid? excludeId) : Task<IActionResult>
    + public GetActiveHospitalsSimple() : Task<IActionResult>
}

' ===== MAPPING PROFILE =====
class HospitalMappingProfile {
    + public HospitalMappingProfile()
    --
    AutoMapper profile for Hospital mappings
}

' ===== EXTERNAL DEPENDENCIES =====
class HospitalDbContext {
    + public DbSet<HospitalEntity> Hospitals
    + public DbSet<HospitalSubscriptionEntity> HospitalSubscriptions
    + public DbSet<HospitalSpecialtyEntity> HospitalSpecialties
    + public DbSet<HospitalImageEntity> HospitalImages
    --
    Entity Framework DbContext
}

class AutoMapper.IMapper {
    + public Map<TSource, TDestination>(TSource source) : TDestination
    --
    AutoMapper interface
}

class ILogger {
    + public LogInformation(string message)
    + public LogError(Exception ex, string message)
    --
    .NET Core logging interface
}

class IAuthService {
    + public GetAccountStatusByIdsAsync(List<Guid> accountIds) : Task<Dictionary<Guid, AccountStatus>>
    + public UpdateAccountStatusAsync(Guid accountId, AccountStatus status) : Task<bool>
    --
    gRPC service for account management
}

class IDoctorService {
    + public GetSpecialtiesAsync() : Task<List<SpecialtyResponse>>
    + public GetPositionsAsync() : Task<List<PositionResponse>>
    + public GetServiceTypesAsync() : Task<List<ServiceTypeResponse>>
    + public GetDoctorCountsByHospitalAsync(Guid hospitalId) : Task<Dictionary<string, int>>
    --
    gRPC service for doctor information
}

' ===== ENUMS =====
enum SubscriptionStatus {
    ACTIVE
    INACTIVE
    EXPIRED
    CANCELLED
}

