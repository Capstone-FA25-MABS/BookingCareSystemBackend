@startuml
!theme plain
title Doctor Class Diagram
hide circle
' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 1
    FontSize 10
}

skinparam arrow {
    Thickness 1
    Color Black
}

skinparam linetype ortho
skinparam packageStyle rectangle

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== CORE ENTITIES =====
class DoctorEntity {
    + Guid Id
    + Guid AccountId
    + string Email
    + string FirstName
    + string LastName
    + Gender? Gender
    + Guid? PositionId
    + Guid? SpecialtyId
    + Guid? HospitalId
    + int YearsOfExperience
    + string AvatarUrl
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

class DoctorPriceEntity {
    + Guid Id
    + Guid DoctorId
    + Guid ServiceTypeId
    + decimal Amount
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

' ===== REQUEST DTOs =====
class CreateDoctorRequest {
    + Guid AccountId
    + string Email
    + string FirstName
    + string LastName
    + Gender? Gender
    + Guid? PositionId
    + Guid? SpecialtyId
    + Guid? HospitalId
    + int YearsOfExperience
    + string AvatarUrl
}

class UpdateDoctorRequest {
    + Guid Id
    + string Email
    + string FirstName
    + string LastName
    + Gender? Gender
    + Guid? PositionId
    + Guid? SpecialtyId
    + Guid? HospitalId
    + int YearsOfExperience
    + string AvatarUrl
}

class DoctorQueryRequest {
    + string? SearchTerm
    + Guid? HospitalId
    + Guid? SpecialtyId
    + Guid? PositionId
    + Gender? Gender
    + int PageNumber
    + int PageSize
}

' ===== RESPONSE DTOs =====
class DoctorResponse {
    + Guid Id
    + string FirstName
    + string LastName
    + string FullName
    + Gender? Gender
    + string? PositionName
    + string? SpecialtyName
    + string? HospitalName
    + int YearsOfExperience
    + string AvatarUrl
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

class DoctorListResponse {
    + List<DoctorResponse> Doctors
    + int TotalCount
    + int PageNumber
    + int PageSize
    + int TotalPages
}

' ===== REPOSITORY INTERFACE =====
interface IDoctorRepository {
    + GetDoctorByIdAsync(Guid id) : Task<DoctorEntity?>
    + GetDoctorByEmailAsync(string email) : Task<DoctorEntity?>
    + CreateDoctorAsync(DoctorEntity doctor) : Task<DoctorEntity>
    + UpdateDoctorAsync(DoctorEntity doctor) : Task<DoctorEntity>
    + DeleteDoctorAsync(Guid id) : Task<bool>
    + GetDoctorsAsync(DoctorQueryRequest query) : Task<(List<DoctorEntity>, int)>
    + GetDoctorsByHospitalAsync(Guid hospitalId) : Task<List<DoctorEntity>>
    + GetDoctorsBySpecialtyAsync(Guid specialtyId) : Task<List<DoctorEntity>>
}

' ===== REPOSITORY IMPLEMENTATION =====
class DoctorRepository {
    - DoctorDbContext _context
    --
    + DoctorRepository(DoctorDbContext context)
    + GetDoctorByIdAsync(Guid id) : Task<DoctorEntity?>
    + GetDoctorByEmailAsync(string email) : Task<DoctorEntity?>
    + CreateDoctorAsync(DoctorEntity doctor) : Task<DoctorEntity>
    + UpdateDoctorAsync(DoctorEntity doctor) : Task<DoctorEntity>
    + DeleteDoctorAsync(Guid id) : Task<bool>
    + GetDoctorsAsync(DoctorQueryRequest query) : Task<(List<DoctorEntity>, int)>
    + GetDoctorsByHospitalAsync(Guid hospitalId) : Task<List<DoctorEntity>>
    + GetDoctorsBySpecialtyAsync(Guid specialtyId) : Task<List<DoctorEntity>>
}

' ===== SERVICE INTERFACE =====
interface IDoctorService {
    + CreateDoctorAsync(CreateDoctorRequest request) : Task<DoctorResponse>
    + GetDoctorByIdAsync(Guid id) : Task<DoctorResponse?>
    + GetDoctorByEmailAsync(string email) : Task<DoctorResponse?>
    + UpdateDoctorAsync(UpdateDoctorRequest request) : Task<DoctorResponse>
    + DeleteDoctorAsync(Guid id) : Task<bool>
    + GetDoctorsAsync(DoctorQueryRequest query) : Task<DoctorListResponse>
    + GetDoctorsByHospitalAsync(Guid hospitalId) : Task<List<DoctorResponse>>
    + GetDoctorsBySpecialtyAsync(Guid specialtyId) : Task<List<DoctorResponse>>
}

' ===== SERVICE IMPLEMENTATION =====
class DoctorService {
    - IDoctorRepository _repository
    - IMapper _mapper
    - ILogger _logger
    --
    + DoctorService(IDoctorRepository repository, IMapper mapper, ILogger logger)
    + CreateDoctorAsync(CreateDoctorRequest request) : Task<DoctorResponse>
    + GetDoctorByIdAsync(Guid id) : Task<DoctorResponse?>
    + GetDoctorByEmailAsync(string email) : Task<DoctorResponse?>
    + UpdateDoctorAsync(UpdateDoctorRequest request) : Task<DoctorResponse>
    + DeleteDoctorAsync(Guid id) : Task<bool>
    + GetDoctorsAsync(DoctorQueryRequest query) : Task<DoctorListResponse>
    + GetDoctorsByHospitalAsync(Guid hospitalId) : Task<List<DoctorResponse>>
    + GetDoctorsBySpecialtyAsync(Guid specialtyId) : Task<List<DoctorResponse>>
}

' ===== CONTROLLER =====
class DoctorsController {
    - IDoctorService _doctorService
    --
    + DoctorsController(IDoctorService doctorService)
    + GetDoctor(Guid id) : Task<IActionResult>
    + GetDoctors(DoctorQueryRequest query) : Task<IActionResult>
    + CreateDoctor(CreateDoctorRequest request) : Task<IActionResult>
    + UpdateDoctor(Guid id, UpdateDoctorRequest request) : Task<IActionResult>
    + DeleteDoctor(Guid id) : Task<IActionResult>
    + GetDoctorsByHospital(Guid hospitalId) : Task<IActionResult>
    + GetDoctorsBySpecialty(Guid specialtyId) : Task<IActionResult>
}

' ===== EXTERNAL DEPENDENCIES =====
class DoctorDbContext {
    + DbSet<DoctorEntity> Doctors
    + DbSet<DoctorPriceEntity> DoctorPrices
}

class AutoMapper.IMapper {
    + Map<TSource, TDestination>(TSource source) : TDestination
}

class ILogger {
    + LogInformation(string message)
    + LogError(Exception ex, string message)
}

' ===== ENUMS =====
enum Gender {
    MALE
    FEMALE
    OTHER
}

' ===== LAYOUT POSITIONING =====
DoctorEntity -[hidden]- CreateDoctorRequest
CreateDoctorRequest -[hidden]- UpdateDoctorRequest
UpdateDoctorRequest -[hidden]- DoctorQueryRequest

DoctorResponse -[hidden]- DoctorListResponse

IDoctorRepository -[hidden]- DoctorRepository
DoctorRepository -[hidden]- DoctorDbContext

IDoctorService -[hidden]- DoctorService
DoctorService -[hidden]- DoctorsController

IMapper -[hidden]- ILogger

' ===== RELATIONSHIPS =====
IDoctorRepository <|.. DoctorRepository
IDoctorService <|.. DoctorService

DoctorRepository --> DoctorDbContext
DoctorRepository --> DoctorEntity
DoctorRepository --> DoctorPriceEntity
DoctorRepository --> DoctorQueryRequest

DoctorService --> IDoctorRepository
DoctorService --> IMapper
DoctorService --> ILogger
DoctorService --> CreateDoctorRequest
DoctorService --> UpdateDoctorRequest
DoctorService --> DoctorQueryRequest
DoctorService --> DoctorResponse
DoctorService --> DoctorListResponse

DoctorsController --> IDoctorService
DoctorsController --> CreateDoctorRequest
DoctorsController --> UpdateDoctorRequest
DoctorsController --> DoctorQueryRequest
DoctorsController --> DoctorResponse
DoctorsController --> DoctorListResponse

DoctorEntity --> Gender
DoctorEntity --> DoctorPriceEntity
CreateDoctorRequest --> Gender
UpdateDoctorRequest --> Gender
DoctorQueryRequest --> Gender
DoctorResponse --> Gender

@enduml