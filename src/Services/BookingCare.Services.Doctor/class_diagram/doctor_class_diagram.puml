@startuml Doctor-Class-Diagram

title BookingCare Doctor Service - Class Diagram

hide circle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 50
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam wrapWidth 220
skinparam maxMessageSize 220

' ========== PRESENTATION LAYER ==========
class DoctorsController {
    - _doctorService: IDoctorService
    - _uploadOrchestrator: FileUploadOrchestrator
    + FilterDoctors(filter): Task<IActionResult>
    + GetDoctor(id): Task<IActionResult>
    + GetDoctors(query): Task<IActionResult>
    + CreateDoctor(request): Task<IActionResult>
    + UpdateDoctor(id, request): Task<IActionResult>
    + DeleteDoctor(id): Task<IActionResult>
    + ToggleDoctorStatus(id): Task<IActionResult>
}

class AvatarController {
        - _doctorService: IDoctorService
        - _uploadOrchestrator: FileUploadOrchestrator
        + UploadAvatar(doctorId, file): Task<IActionResult>
        + DeleteAvatar(doctorId): Task<IActionResult>
}

class SpecialtiesController {
        - _specialtyService: ISpecialtyService
        + CreateSpecialty(request): Task<IActionResult>
        + GetSpecialty(id): Task<IActionResult>
        + UpdateSpecialty(id, request): Task<IActionResult>
        + DeleteSpecialty(id): Task<IActionResult>
        + GetSpecialties(query): Task<IActionResult>
        + ToggleSpecialtyStatus(id): Task<IActionResult>
}

class PositionsController {
        - _positionService: IPositionService
        + CreatePosition(request): Task<IActionResult>
        + GetPosition(id): Task<IActionResult>
        + UpdatePosition(id, request): Task<IActionResult>
        + DeletePosition(id): Task<IActionResult>
        + GetPositions(query): Task<IActionResult>
        + TogglePositionStatus(id): Task<IActionResult>
}

' ========== SERVICE LAYER ==========
interface IDoctorService {
    + CreateDoctorAsync(request): Task<DoctorResponse>
    + GetDoctorByIdAsync(id): Task<DoctorByIdResponse?>
    + UpdateDoctorAsync(request): Task<DoctorResponse>
    + DeleteDoctorAsync(id): Task<bool>
    + GetDoctorsAsync(query): Task<DoctorListResponse>
    + FilterDoctorsOptimizedAsync(filter): Task<DoctorSearchListResponse>
}

interface ISpecialtyService {
        + CreateSpecialtyAsync(request): Task<SpecialtyResponse>
        + GetSpecialtyByIdAsync(id): Task<SpecialtyResponse?>
        + UpdateSpecialtyAsync(request): Task<SpecialtyResponse>
        + GetSpecialtiesAsync(query): Task<SpecialtyListResponse>
}

interface IPositionService {
        + CreatePositionAsync(request): Task<PositionResponse>
        + GetPositionByIdAsync(id): Task<PositionResponse?>
        + UpdatePositionAsync(request): Task<PositionResponse>
        + GetPositionsAsync(query): Task<PositionListResponse>
}

class DoctorService {
        - _repository: IDoctorRepository
        - _mapper: IMapper
        - _favoritesClient: FavoritesServiceClient
        - _authClient: AuthServiceClient
        - _hospitalClient: HospitalServiceClient
        - _reviewClient: ReviewServiceClient
        + CreateDoctorAsync(request): Task<DoctorResponse>
        + GetDoctorByIdAsync(id): Task<DoctorByIdResponse?>
        + UpdateDoctorAsync(request): Task<DoctorResponse>
        + GetDoctorsAsync(query): Task<DoctorListResponse>
        + FilterDoctorsOptimizedAsync(filter): Task<DoctorSearchListResponse>
}

class SpecialtyService {
        - _specialtyRepository: ISpecialtyRepository
        - _mapper: IMapper
        + CreateSpecialtyAsync(request): Task<SpecialtyResponse>
        + GetSpecialtyByIdAsync(id): Task<SpecialtyResponse?>
        + UpdateSpecialtyAsync(request): Task<SpecialtyResponse>
        + DeleteSpecialtyAsync(id): Task<bool>
        + GetSpecialtiesAsync(query): Task<SpecialtyListResponse>
}

class PositionService {
        - _positionRepository: IPositionRepository
        - _mapper: IMapper
        + CreatePositionAsync(request): Task<PositionResponse>
        + GetPositionByIdAsync(id): Task<PositionResponse?>
        + UpdatePositionAsync(request): Task<PositionResponse>
        + DeletePositionAsync(id): Task<bool>
        + GetPositionsAsync(query): Task<PositionListResponse>
}

' ========== REPOSITORY LAYER ==========
interface IDoctorRepository {
    + GetDoctorByIdAsync(id): Task<DoctorEntity?>
    + CreateDoctorAsync(doctor): Task<DoctorEntity>
    + UpdateDoctorAsync(doctor): Task<DoctorEntity>
    + DeleteDoctorAsync(id): Task<bool>
    + GetDoctorsAsync(query): Task<(List<DoctorEntity>, int)>
}

interface ISpecialtyRepository {
        + GetSpecialtyByIdAsync(id): Task<SpecialtyEntity?>
        + CreateSpecialtyAsync(specialty): Task<SpecialtyEntity>
        + UpdateSpecialtyAsync(specialty): Task<SpecialtyEntity>
        + DeleteSpecialtyAsync(id): Task<bool>
        + GetSpecialtiesAsync(query): Task<(List<SpecialtyEntity>, int)>
}

interface IPositionRepository {
        + GetPositionByIdAsync(id): Task<PositionEntity?>
        + CreatePositionAsync(position): Task<PositionEntity>
        + UpdatePositionAsync(position): Task<PositionEntity>
        + DeletePositionAsync(id): Task<bool>
        + GetPositionsAsync(query): Task<(List<PositionEntity>, int)>
}

class DoctorRepository {
        - _context: DoctorDbContext
        + GetDoctorByIdAsync(id): Task<DoctorEntity?>
        + CreateDoctorAsync(doctor): Task<DoctorEntity>
        + UpdateDoctorAsync(doctor): Task<DoctorEntity>
        + DeleteDoctorAsync(id): Task<bool>
        + GetDoctorsAsync(query): Task<(List<DoctorEntity>, int)>
}

class SpecialtyRepository {
        - _context: DoctorDbContext
        + GetSpecialtyByIdAsync(id): Task<SpecialtyEntity?>
        + CreateSpecialtyAsync(specialty): Task<SpecialtyEntity>
        + UpdateSpecialtyAsync(specialty): Task<SpecialtyEntity>
        + DeleteSpecialtyAsync(id): Task<bool>
        + GetSpecialtiesAsync(query): Task<(List<SpecialtyEntity>, int)>
}

class PositionRepository {
        - _context: DoctorDbContext
        + GetPositionByIdAsync(id): Task<PositionEntity?>
        + CreatePositionAsync(position): Task<PositionEntity>
        + UpdatePositionAsync(position): Task<PositionEntity>
        + DeletePositionAsync(id): Task<bool>
        + GetPositionsAsync(query): Task<(List<PositionEntity>, int)>
}

' ========== DATA LAYER ==========
class DoctorDbContext {
    + Doctors: DbSet<DoctorEntity>
    + Positions: DbSet<PositionEntity>
    + Specialties: DbSet<SpecialtyEntity>
}

' ========== ENTITIES ==========
class DoctorEntity {
    + Id: Guid
    + AccountId: Guid
    + Email: string
    + FirstName: string
    + LastName: string
    + Gender: Gender?
    + YearsOfExperience: int
    + AvatarUrl: string
    + PositionId: Guid?
    + SpecialtyId: Guid?
    + HospitalId: Guid?
    + CreatedAt: DateTime
    + UpdatedAt: DateTime
    + Position: PositionEntity?
    + Specialty: SpecialtyEntity?
}

class PositionEntity {
    + Id: Guid
    + Name: string
    + Status: Status
    + CreatedAt: DateTime
    + UpdatedAt: DateTime
}

class SpecialtyEntity {
    + Id: Guid
    + Name: string
    + ImageUrl: string
    + Status: Status
    + CreatedAt: DateTime
    + UpdatedAt: DateTime
}

' ========== DTOs ==========
class CreateDoctorRequest {
    + AccountId: Guid
    + Email: string
    + FirstName: string
    + LastName: string
    + YearsOfExperience: int
    + Gender: Gender?
    + PositionId: Guid?
    + SpecialtyId: Guid?
    + HospitalId: Guid?
}

class DoctorQueryRequest {
    + AccountId: Guid?
    + PositionId: Guid?
    + SpecialtyId: Guid?
    + HospitalId: Guid?
    + Gender: string?
    + SearchTerm: string?
    + PageNumber: int
    + PageSize: int
}

class DoctorAdvancedFilterRequest {
    + SpecialtyId: Guid?
    + PositionId: Guid?
    + Gender: string?
    + MinYearsOfExperience: int?
    + MaxYearsOfExperience: int?
    + ProvinceId: string?
    + DistrictId: string?
    + PageNumber: int
    + PageSize: int
}

class DoctorResponse {
    + Id: Guid
    + AccountId: Guid
    + Email: string
    + FirstName: string
    + LastName: string
    + Gender: Gender?
    + YearsOfExperience: int
    + AvatarUrl: string
    + Position: PositionResponse?
    + Specialty: SpecialtyResponse?
    + Hospital: HospitalBasicInfo?
}

class CreateSpecialtyRequest {
    + Name: string
    + ImageUrl: string
    + Status: Status
}

class SpecialtyResponse {
    + Id: Guid
    + Name: string
    + ImageUrl: string
    + Status: Status
}

class CreatePositionRequest {
    + Name: string
    + Status: Status
}

class PositionResponse {
    + Id: Guid
    + Name: string
    + Status: Status
}

' ========== LAYOUT HINTS ==========
DoctorsController -[hidden]down- IDoctorService
IDoctorService -[hidden]down- IDoctorRepository
IDoctorRepository -[hidden]down- DoctorDbContext

SpecialtiesController -[hidden]down- ISpecialtyService
ISpecialtyService -[hidden]down- ISpecialtyRepository
ISpecialtyRepository -[hidden]down- DoctorDbContext

PositionsController -[hidden]down- IPositionService
IPositionService -[hidden]down- IPositionRepository
IPositionRepository -[hidden]down- DoctorDbContext

' ========== RELATIONSHIPS ==========

' Controller Layer
DoctorsController *-- IDoctorService
DoctorsController o-- FileUploadOrchestrator
AvatarController *-- IDoctorService
SpecialtiesController *-- ISpecialtyService
PositionsController *-- IPositionService

' Service Layer
DoctorService ..|> IDoctorService
DoctorService *-- IDoctorRepository
DoctorService o-- IMapper
DoctorService o-- FavoritesServiceClient
DoctorService o-- AuthServiceClient
DoctorService o-- HospitalServiceClient
DoctorService o-- ReviewServiceClient

SpecialtyService ..|> ISpecialtyService
SpecialtyService *-- ISpecialtyRepository
SpecialtyService o-- IMapper

PositionService ..|> IPositionService
PositionService *-- IPositionRepository
PositionService o-- IMapper

' Repository Layer
DoctorRepository ..|> IDoctorRepository
DoctorRepository *-- DoctorDbContext

SpecialtyRepository ..|> ISpecialtyRepository
SpecialtyRepository *-- DoctorDbContext

PositionRepository ..|> IPositionRepository
PositionRepository *-- DoctorDbContext

' Entity Relationships
DoctorEntity "*" -- "0..1" PositionEntity
DoctorEntity "*" -- "0..1" SpecialtyEntity

' Service Uses DTOs
IDoctorService ..> CreateDoctorRequest
IDoctorService ..> DoctorQueryRequest
IDoctorService ..> DoctorAdvancedFilterRequest
IDoctorService ..> DoctorResponse

ISpecialtyService ..> CreateSpecialtyRequest
ISpecialtyService ..> SpecialtyResponse

IPositionService ..> CreatePositionRequest
IPositionService ..> PositionResponse

' Repository Uses Entities
IDoctorRepository ..> DoctorEntity
ISpecialtyRepository ..> SpecialtyEntity
IPositionRepository ..> PositionEntity

@enduml
