@startuml
!theme plain
title Specialty Class Diagram - BookingCare.Services.Doctor

' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 2
}

skinparam arrow {
    Thickness 2
    Color Black
}

skinparam linetype ortho

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== ENTITIES =====
class BaseEntity {
    + public Guid Id
    + public string Name
    + public Status Status
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
}

class SpecialtyEntity {
    + public string Name
    + public string ImageUrl
    --
    [Table("specialties")]
    [MaxLength(255)]
    [Column("name")]
    [Column("image_url")]
}

' ===== REQUEST DTOs =====
class CreateSpecialtyRequest {
    + public string Name
    + public string ImageUrl
    + public Status Status
    --
    [Required]
    [StringLength(255, MinimumLength = 2)]
    [Required]
    [Url]
}

class UpdateSpecialtyRequest {
    + public Guid Id
    + public string Name
    + public string ImageUrl
    + public Status Status
    --
    [Required]
    [JsonRequired]
    [StringLength(255, MinimumLength = 2)]
    [Required]
    [Url]
}

class SpecialtyQueryRequest {
    + public string? SearchTerm
    + public Status? Status
    + public int PageNumber
    + public int PageSize
    + public string? SortBy
    + public string? SortOrder
    --
    [JsonRequired]
}

' ===== RESPONSE DTOs =====
class SpecialtyResponse {
    + public Guid Id
    + public string Name
    + public string ImageUrl
    + public Status Status
    + public int DoctorCount
    + public DateTime CreatedAt
    + public DateTime UpdatedAt
}

class SpecialtyListResponse {
    + public List<SpecialtyResponse> Specialties
    + public int TotalCount
    + public int PageNumber
    + public int PageSize
    + public int TotalPages
}

class SpecialtySimpleResponse {
    + public Guid Id
    + public string Name
    + public int DoctorCount
    --
    Simple response DTO for performance optimization
}

' ===== REPOSITORY INTERFACE =====
interface ISpecialtyRepository {
    + public GetSpecialtyByIdAsync(Guid id) : Task<SpecialtyEntity?>
    + public GetSpecialtyByNameAsync(string name) : Task<SpecialtyEntity?>
    + public CreateSpecialtyAsync(SpecialtyEntity specialty) : Task<SpecialtyEntity>
    + public UpdateSpecialtyAsync(SpecialtyEntity specialty) : Task<SpecialtyEntity>
    + public DeleteSpecialtyAsync(Guid id) : Task<bool>
    + public SpecialtyExistsAsync(Guid id) : Task<bool>
    + public SpecialtyNameExistsAsync(string name, Guid? excludeId) : Task<bool>
    + public GetSpecialtiesAsync(SpecialtyQueryRequest query) : Task<(List<SpecialtyEntity>, int)>
    + public GetAllSpecialtiesAsync() : Task<List<SpecialtyEntity>>
    + public GetSpecialtiesByIdsAsync(List<Guid> ids) : Task<List<SpecialtyEntity>>
    + public GetDoctorCountsBySpecialtyAsync() : Task<Dictionary<Guid, int>>
    + public GetActiveSpecialtiesSimpleAsync() : Task<List<SpecialtyEntity>>
    + public GetActiveDoctorCountsBySpecialtyAsync() : Task<Dictionary<Guid, int>>
}

' ===== REPOSITORY IMPLEMENTATION =====
class SpecialtyRepository {
    - private DoctorDbContext _context
    --
    + public SpecialtyRepository(DoctorDbContext context)
    + public GetSpecialtyByIdAsync(Guid id) : Task<SpecialtyEntity?>
    + public GetSpecialtyByNameAsync(string name) : Task<SpecialtyEntity?>
    + public CreateSpecialtyAsync(SpecialtyEntity specialty) : Task<SpecialtyEntity>
    + public UpdateSpecialtyAsync(SpecialtyEntity specialty) : Task<SpecialtyEntity>
    + public DeleteSpecialtyAsync(Guid id) : Task<bool>
    + public SpecialtyExistsAsync(Guid id) : Task<bool>
    + public SpecialtyNameExistsAsync(string name, Guid? excludeId) : Task<bool>
    + public GetSpecialtiesAsync(SpecialtyQueryRequest query) : Task<(List<SpecialtyEntity>, int)>
    + public GetAllSpecialtiesAsync() : Task<List<SpecialtyEntity>>
    + public GetSpecialtiesByIdsAsync(List<Guid> ids) : Task<List<SpecialtyEntity>>
    + public GetDoctorCountsBySpecialtyAsync() : Task<Dictionary<Guid, int>>
    + public GetActiveSpecialtiesSimpleAsync() : Task<List<SpecialtyEntity>>
    + public GetActiveDoctorCountsBySpecialtyAsync() : Task<Dictionary<Guid, int>>
    - private ApplySorting(IQueryable<SpecialtyEntity> queryable, SpecialtyQueryRequest query) : IQueryable<SpecialtyEntity>
}

' ===== SERVICE INTERFACE =====
interface ISpecialtyService {
    + public CreateSpecialtyAsync(CreateSpecialtyRequest request) : Task<SpecialtyResponse>
    + public GetSpecialtyByIdAsync(Guid id) : Task<SpecialtyResponse?>
    + public GetSpecialtyByNameAsync(string name) : Task<SpecialtyResponse?>
    + public UpdateSpecialtyAsync(UpdateSpecialtyRequest request) : Task<SpecialtyResponse>
    + public DeleteSpecialtyAsync(Guid id) : Task<bool>
    + public ToggleSpecialtyStatusAsync(Guid id) : Task<bool>
    + public GetSpecialtiesAsync(SpecialtyQueryRequest query) : Task<SpecialtyListResponse>
    + public GetAllSpecialtiesAsync() : Task<List<SpecialtyResponse>>
    + public GetActiveSpecialtiesSimpleAsync() : Task<List<SpecialtySimpleResponse>>
    + public SpecialtyExistsAsync(Guid id) : Task<bool>
    + public SpecialtyNameExistsAsync(string name, Guid? excludeId) : Task<bool>
}

' ===== SERVICE IMPLEMENTATION =====
class SpecialtyService {
    - private ISpecialtyRepository _repository
    - private IMapper _mapper
    - private ILogger _logger
    --
    + public SpecialtyService(ISpecialtyRepository repository, IMapper mapper, ILogger logger)
    + public CreateSpecialtyAsync(CreateSpecialtyRequest request) : Task<SpecialtyResponse>
    + public GetSpecialtyByIdAsync(Guid id) : Task<SpecialtyResponse?>
    + public GetSpecialtyByNameAsync(string name) : Task<SpecialtyResponse?>
    + public UpdateSpecialtyAsync(UpdateSpecialtyRequest request) : Task<SpecialtyResponse>
    + public DeleteSpecialtyAsync(Guid id) : Task<bool>
    + public ToggleSpecialtyStatusAsync(Guid id) : Task<bool>
    + public GetSpecialtiesAsync(SpecialtyQueryRequest query) : Task<SpecialtyListResponse>
    + public GetAllSpecialtiesAsync() : Task<List<SpecialtyResponse>>
    + public GetActiveSpecialtiesSimpleAsync() : Task<List<SpecialtySimpleResponse>>
    + public SpecialtyExistsAsync(Guid id) : Task<bool>
    + public SpecialtyNameExistsAsync(string name, Guid? excludeId) : Task<bool>
}

' ===== CONTROLLER =====
class SpecialtiesController {
    - private ISpecialtyService _specialtyService
    --
    + public SpecialtiesController(ISpecialtyService specialtyService)
    + public Health() : IActionResult
    + public GetSpecialty(Guid id) : Task<IActionResult>
    + public GetSpecialtyByName(string name) : Task<IActionResult>
    + public GetSpecialties(SpecialtyQueryRequest query) : Task<IActionResult>
    + public GetAllSpecialties() : Task<IActionResult>
    + public CreateSpecialty(CreateSpecialtyRequest request) : Task<IActionResult>
    + public UpdateSpecialty(Guid id, UpdateSpecialtyRequest request) : Task<IActionResult>
    + public DeleteSpecialty(Guid id) : Task<IActionResult>
    + public ToggleSpecialtyStatus(Guid id) : Task<IActionResult>
    + public ValidateSpecialtyName(string name, Guid? excludeId) : Task<IActionResult>
}

' ===== MAPPING PROFILE =====
class SpecialtyMappingProfile {
    + public SpecialtyMappingProfile()
    --
    AutoMapper profile for Specialty mappings
}

' ===== EXTERNAL DEPENDENCIES =====
class DoctorDbContext {
    + public DbSet<SpecialtyEntity> Specialties
    --
    Entity Framework DbContext
}

class AutoMapper.IMapper {
    + public Map<TSource, TDestination>(TSource source) : TDestination
    --
    AutoMapper interface
}

class ILogger {
    + public LogInformation(string message)
    + public LogError(Exception ex, string message)
    --
    .NET Core logging interface
}

' ===== ENUMS =====
enum Status {
    ACTIVE
    INACTIVE
}

' ===== LAYOUT POSITIONING =====
' Entities
BaseEntity -[hidden]- SpecialtyEntity
SpecialtyEntity -[hidden]- Status

' Request DTOs
CreateSpecialtyRequest -[hidden]- UpdateSpecialtyRequest
UpdateSpecialtyRequest -[hidden]- SpecialtyQueryRequest

' Response DTOs
SpecialtyResponse -[hidden]- SpecialtyListResponse
SpecialtyListResponse -[hidden]- SpecialtySimpleResponse

' Repository Layer
ISpecialtyRepository -[hidden]- SpecialtyRepository
SpecialtyRepository -[hidden]- DoctorDbContext

' Service Layer
ISpecialtyService -[hidden]- SpecialtyService
SpecialtyService -[hidden]- IMapper
IMapper -[hidden]- ILogger

' Controller
SpecialtiesController -[hidden]- SpecialtyMappingProfile

' ===== RELATIONSHIPS =====
BaseEntity <|-- SpecialtyEntity
ISpecialtyRepository <|.. SpecialtyRepository
ISpecialtyService <|.. SpecialtyService

SpecialtyRepository --> DoctorDbContext
SpecialtyRepository --> SpecialtyEntity
SpecialtyRepository --> SpecialtyQueryRequest

SpecialtyService --> ISpecialtyRepository
SpecialtyService --> IMapper
SpecialtyService --> ILogger
SpecialtyService --> CreateSpecialtyRequest
SpecialtyService --> UpdateSpecialtyRequest
SpecialtyService --> SpecialtyQueryRequest
SpecialtyService --> SpecialtyResponse
SpecialtyService --> SpecialtyListResponse
SpecialtyService --> SpecialtySimpleResponse

SpecialtiesController --> ISpecialtyService
SpecialtiesController --> CreateSpecialtyRequest
SpecialtiesController --> UpdateSpecialtyRequest
SpecialtiesController --> SpecialtyQueryRequest
SpecialtiesController --> SpecialtyResponse
SpecialtiesController --> SpecialtyListResponse
SpecialtiesController --> SpecialtySimpleResponse

SpecialtyMappingProfile --> SpecialtyEntity
SpecialtyMappingProfile --> CreateSpecialtyRequest
SpecialtyMappingProfile --> UpdateSpecialtyRequest
SpecialtyMappingProfile --> SpecialtyResponse
SpecialtyMappingProfile --> SpecialtyListResponse

SpecialtyEntity --> Status
CreateSpecialtyRequest --> Status
UpdateSpecialtyRequest --> Status
SpecialtyResponse --> Status

@enduml
