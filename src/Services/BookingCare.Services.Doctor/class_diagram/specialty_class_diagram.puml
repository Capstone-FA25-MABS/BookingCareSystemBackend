@startuml
!theme plain
title Specialty Class Diagram
hide circle

' ===== SKIN PARAMETERS =====
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    ArrowThickness 1
    FontSize 10
}

skinparam arrow {
    Thickness 1
    Color Black
}

skinparam linetype ortho
skinparam packageStyle rectangle

' ===== VISIBILITY MODIFIERS =====
skinparam classAttribute {
    IconSize 0
    FontSize 10
}

skinparam classMethod {
    IconSize 0
    FontSize 10
}

' ===== CORE ENTITIES =====
class SpecialtyEntity {
    + Guid Id
    + string Name
    + string ImageUrl
    + Status Status
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

' ===== REQUEST DTOs =====
class CreateSpecialtyRequest {
    + string Name
    + string ImageUrl
    + Status Status
}

class UpdateSpecialtyRequest {
    + Guid Id
    + string Name
    + string ImageUrl
    + Status Status
}

class SpecialtyQueryRequest {
    + string? SearchTerm
    + Status? Status
    + int PageNumber
    + int PageSize
}

' ===== RESPONSE DTOs =====
class SpecialtyResponse {
    + Guid Id
    + string Name
    + string ImageUrl
    + Status Status
    + int DoctorCount
    + DateTime CreatedAt
    + DateTime UpdatedAt
}

class SpecialtyListResponse {
    + List<SpecialtyResponse> Specialties
    + int TotalCount
    + int PageNumber
    + int PageSize
    + int TotalPages
}

' ===== REPOSITORY INTERFACE =====
interface ISpecialtyRepository {
    + GetSpecialtyByIdAsync(Guid id) : Task<SpecialtyEntity?>
    + GetSpecialtyByNameAsync(string name) : Task<SpecialtyEntity?>
    + CreateSpecialtyAsync(SpecialtyEntity specialty) : Task<SpecialtyEntity>
    + UpdateSpecialtyAsync(SpecialtyEntity specialty) : Task<SpecialtyEntity>
    + DeleteSpecialtyAsync(Guid id) : Task<bool>
    + GetSpecialtiesAsync(SpecialtyQueryRequest query) : Task<(List<SpecialtyEntity>, int)>
    + GetAllSpecialtiesAsync() : Task<List<SpecialtyEntity>>
}

' ===== REPOSITORY IMPLEMENTATION =====
class SpecialtyRepository {
    - DoctorDbContext _context
    --
    + SpecialtyRepository(DoctorDbContext context)
    + GetSpecialtyByIdAsync(Guid id) : Task<SpecialtyEntity?>
    + GetSpecialtyByNameAsync(string name) : Task<SpecialtyEntity?>
    + CreateSpecialtyAsync(SpecialtyEntity specialty) : Task<SpecialtyEntity>
    + UpdateSpecialtyAsync(SpecialtyEntity specialty) : Task<SpecialtyEntity>
    + DeleteSpecialtyAsync(Guid id) : Task<bool>
    + GetSpecialtiesAsync(SpecialtyQueryRequest query) : Task<(List<SpecialtyEntity>, int)>
    + GetAllSpecialtiesAsync() : Task<List<SpecialtyEntity>>
}

' ===== SERVICE INTERFACE =====
interface ISpecialtyService {
    + CreateSpecialtyAsync(CreateSpecialtyRequest request) : Task<SpecialtyResponse>
    + GetSpecialtyByIdAsync(Guid id) : Task<SpecialtyResponse?>
    + GetSpecialtyByNameAsync(string name) : Task<SpecialtyResponse?>
    + UpdateSpecialtyAsync(UpdateSpecialtyRequest request) : Task<SpecialtyResponse>
    + DeleteSpecialtyAsync(Guid id) : Task<bool>
    + GetSpecialtiesAsync(SpecialtyQueryRequest query) : Task<SpecialtyListResponse>
    + GetAllSpecialtiesAsync() : Task<List<SpecialtyResponse>>
}

' ===== SERVICE IMPLEMENTATION =====
class SpecialtyService {
    - ISpecialtyRepository _repository
    - IMapper _mapper
    - ILogger _logger
    --
    + SpecialtyService(ISpecialtyRepository repository, IMapper mapper, ILogger logger)
    + CreateSpecialtyAsync(CreateSpecialtyRequest request) : Task<SpecialtyResponse>
    + GetSpecialtyByIdAsync(Guid id) : Task<SpecialtyResponse?>
    + GetSpecialtyByNameAsync(string name) : Task<SpecialtyResponse?>
    + UpdateSpecialtyAsync(UpdateSpecialtyRequest request) : Task<SpecialtyResponse>
    + DeleteSpecialtyAsync(Guid id) : Task<bool>
    + GetSpecialtiesAsync(SpecialtyQueryRequest query) : Task<SpecialtyListResponse>
    + GetAllSpecialtiesAsync() : Task<List<SpecialtyResponse>>
}

' ===== CONTROLLER =====
class SpecialtiesController {
    - ISpecialtyService _specialtyService
    --
    + SpecialtiesController(ISpecialtyService specialtyService)
    + GetSpecialty(Guid id) : Task<IActionResult>
    + GetSpecialtyByName(string name) : Task<IActionResult>
    + GetSpecialties(SpecialtyQueryRequest query) : Task<IActionResult>
    + GetAllSpecialties() : Task<IActionResult>
    + CreateSpecialty(CreateSpecialtyRequest request) : Task<IActionResult>
    + UpdateSpecialty(Guid id, UpdateSpecialtyRequest request) : Task<IActionResult>
    + DeleteSpecialty(Guid id) : Task<IActionResult>
}

' ===== EXTERNAL DEPENDENCIES =====
class DoctorDbContext {
    + DbSet<SpecialtyEntity> Specialties
}

class AutoMapper.IMapper {
    + Map<TSource, TDestination>(TSource source) : TDestination
}

class ILogger {
    + LogInformation(string message)
    + LogError(Exception ex, string message)
}

' ===== ENUMS =====
enum Status {
    ACTIVE
    INACTIVE
}

' ===== LAYOUT POSITIONING =====
SpecialtyEntity -[hidden]- CreateSpecialtyRequest
CreateSpecialtyRequest -[hidden]- UpdateSpecialtyRequest
UpdateSpecialtyRequest -[hidden]- SpecialtyQueryRequest

SpecialtyResponse -[hidden]- SpecialtyListResponse

ISpecialtyRepository -[hidden]- SpecialtyRepository
SpecialtyRepository -[hidden]- DoctorDbContext

ISpecialtyService -[hidden]- SpecialtyService
SpecialtyService -[hidden]- SpecialtiesController

IMapper -[hidden]- ILogger

' ===== RELATIONSHIPS =====
ISpecialtyRepository <|.. SpecialtyRepository
ISpecialtyService <|.. SpecialtyService

SpecialtyRepository --> DoctorDbContext
SpecialtyRepository --> SpecialtyEntity
SpecialtyRepository --> SpecialtyQueryRequest

SpecialtyService --> ISpecialtyRepository
SpecialtyService --> IMapper
SpecialtyService --> ILogger
SpecialtyService --> CreateSpecialtyRequest
SpecialtyService --> UpdateSpecialtyRequest
SpecialtyService --> SpecialtyQueryRequest
SpecialtyService --> SpecialtyResponse
SpecialtyService --> SpecialtyListResponse

SpecialtiesController --> ISpecialtyService
SpecialtiesController --> CreateSpecialtyRequest
SpecialtiesController --> UpdateSpecialtyRequest
SpecialtiesController --> SpecialtyQueryRequest
SpecialtiesController --> SpecialtyResponse
SpecialtiesController --> SpecialtyListResponse

SpecialtyEntity --> Status
CreateSpecialtyRequest --> Status
UpdateSpecialtyRequest --> Status
SpecialtyQueryRequest --> Status
SpecialtyResponse --> Status

@enduml