{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=booking_care_auth_db;Trusted_Connection=true;TrustServerCertificate=true"
  },
  "Jwt": {
    "SecretKey": "***",
    "Issuer": "BookingCare.Auth",
    "Audience": "BookingCare.API",
    "AccessTokenExpirationMinutes": 1,
    "RefreshTokenExpirationDays": 7
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "OtpVerification": {
    "Secret": "***",
    "UseGrpc": true,
    "AllowProofFallback": true,
    "GrpcEndpoint": "http://localhost:6020",
    "TimeoutMs": 1500,
    "MaxProofAgeMinutes": 5
  },
  "FrontendOptions": {
    "Client": {
      "BaseUrl": "http://localhost:5173/"
    },
    "Admin": {
      "BaseUrl": "http://localhost:5174/"
    },
    "Default": {
      "BaseUrl": "http://localhost:5173/"
    },
    "HostMap": {
      "localhost:5174": "admin",
      "localhost:5173": "client"
    }
  },
  "ExternalAuth": {
    "Google": {
      "ClientId": "***"
    },
    "Facebook": {
      "AppId": "***",
      "AppSecret": "***"
    }
  },
  "AllowedOrigins": ["http://localhost:5173", "http://localhost:5174"]
}
