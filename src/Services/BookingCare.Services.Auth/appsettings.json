{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "BookingCare.Shared.Saga": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Saga": {
    "StateStoreType": "SqlServer",
    "ConnectionString": "Server=localhost,1400;Database=MABS_Sagas;User Id=sa;Password=Saga@1234;TrustServerCertificate=true;",
    "ProcessingInterval": "00:01:00",
    "DefaultTimeout": "00:10:00"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "bookingcare",
    "Password": "bookingcare@1234",
    "VirtualHost": "/",
    "ExchangeName": "booking_care_event_bus",
    "QueueName": "auth_service_queue",
    "RetryCount": 3,
    "ConnectionTimeout": 30000,
    "RequestedHeartbeat": 60,
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryInterval": 5000,
    "PersistentMessages": true,
    "AutoDeleteQueue": false,
    "DurableQueue": true,
    "ExclusiveQueue": false
  },
  "Services": {
    "Auth": {
      "GrpcUrl": "http://localhost:6013"
    },
    "User": {
      "GrpcUrl": "http://localhost:6024"
    },
    "Notification": {
      "GrpcUrl": "http://localhost:6020"
    }
  }
}
