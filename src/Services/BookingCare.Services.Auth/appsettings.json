{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=booking_care_auth_db;Trusted_Connection=true;TrustServerCertificate=true"
  },
  "Jwt": {
    "SecretKey": "***",
    "Issuer": "BookingCare.Auth",
    "Audience": "BookingCare.API",
    "AccessTokenExpirationMinutes": 1,
    "RefreshTokenExpirationDays": 7
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "bookingcare",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "booking_care_event_bus",
    "QueueName": "auth_service_queue",
    "RetryCount": 3,
    "ConnectionTimeout": 30000,
    "RequestedHeartbeat": 60,
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryInterval": 5000,
    "PersistentMessages": true,
    "AutoDeleteQueue": false,
    "DurableQueue": true,
    "ExclusiveQueue": false
  },
  "OtpVerification": {
    "Secret": "***",
    "UseGrpc": true,
    "AllowProofFallback": true,
    "GrpcEndpoint": "http://localhost:6110",
    "TimeoutMs": 1500,
    "MaxProofAgeMinutes": 5
  },
  "FrontendOptions": {
    "Client": {
      "BaseUrl": "http://localhost:5173/"
    },
    "Admin": {
      "BaseUrl": "http://localhost:5174/"
    },
    "Default": {
      "BaseUrl": "http://localhost:5173/"
    },
    "HostMap": {
      "localhost:5174": "admin",
      "localhost:5173": "client"
    }
  },
  "DefaultAvatars": {
    "User": {
      "Male": "https://d24em9p7s2uixh.cloudfront.net/avatars/patients/male_20251003_f9c91483.png",
      "Female": "https://d24em9p7s2uixh.cloudfront.net/avatars/patients/female_20251003_d13e4998.png"
    }
  },
  "ExternalAuth": {
    "Google": {
      "ClientId": "***"
    },
    "Facebook": {
      "AppId": "***",
      "AppSecret": "***"
    }
  },
  "Saga": {
    "StateStoreType": "SqlServer",
    "ConnectionString": "Server=localhost,1400;Database=MABS_Sagas;User Id=sa;Password=***;TrustServerCertificate=true",
    "ProcessingInterval": "00:01:00",
    "DefaultTimeout": "00:15:00"
  },
  "Services": {
    "Auth": {
      "GrpcUrl": "http://localhost:6103"
    },
    "User": {
      "GrpcUrl": "http://localhost:6116"
    },
    "Doctor": {
