{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=PaymentDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:6011"
      },
      "Grpc": {
        "Url": "http://localhost:6021",
        "Protocols": "Http2"
      }
    }
  },
  "VNPayConfiguration": {
    "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:6011/api/vnpay/callback",
    "TmnCode": "xxxxx",
    "HashSecret": "xxxxx",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "TimeoutInMinutes": 15
  },
  "PayOSConfiguration": {
    "ClientId": "xxxxx",
    "ApiKey": "xxxxx",
    "ChecksumKey": "xxxxx",
    "ReturnUrl": "http://localhost:6011/api/payos/payos-return",
    "CancelUrl": "http://localhost:6011/api/payos/cancel-callback",
    "TimeoutInMinutes": 15,
    "CleanupIntervalMinutes": 60
  }
}