{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MABS_Appointments;Trusted_Connection=true;TrustServerCertificate=true"
  },
  "Cache": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "Database": 0,
    "KeyPrefix": "BookingCare:Appointment:"
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "bookingcare",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "booking_care_event_bus",
    "QueueName": "appointment_service_queue",
    "RetryCount": 3,
    "ConnectionTimeout": 30000,
    "RequestedHeartbeat": 60,
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryInterval": 5000,
    "PersistentMessages": true,
    "AutoDeleteQueue": false,
    "DurableQueue": true,
    "ExclusiveQueue": false
  },
  "AWS": {
    "S3": {
      "AccessKey": "xxxx",
      "SecretKey": "xxxx",
      "BucketName": "mabs-capstone-fa25-booking-care-s3-bucket",
      "Region": "ap-southeast-1",
      "CloudFrontDomain": "d24em9p7s2uixh.cloudfront.net",
      "CloudFrontDistributionId": "E3BCCKKHWEEXE",
      "PresignedUrlExpiryHours": 1,
      "MaxFileSizeBytes": 10485760,
      "AllowedFileExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".pdf",
        ".doc",
        ".docx",
        ".txt"
      ],
      "FileUploadPath": "uploads/"
    },
    "CloudFront": {
      "DistributionId": "E3BCCKKHWEEXE3",
      "Domain": "d24em9p7s2uixh.cloudfront.net",
      "CacheTtlSeconds": 86400,
      "EnableInvalidation": false
    }
  },
  "Services": {
    "Doctor": {
      "GrpcUrl": "http://localhost:6108"
    },
    "User": {
      "GrpcUrl": "http://localhost:6116"
    },
    "Hospital": {
      "GrpcUrl": "http://localhost:6104"
    },
    "Service": {
      "GrpcUrl": "http://localhost:6115"
    },
    "Payment": {
      "GrpcUrl": "http://localhost:6111"
    }
  },
  "BackgroundServices": {
    "AppointmentStatusUpdate": {
      "CheckIntervalHours": 1,
      "StartupDelaySeconds": 30
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}