# Environment variables for Discount Service Docker deployment
# Copy this file to .env and customize the values

# Database Configuration
DISCOUNT_DB_PASSWORD=YourStrongPassword123!
DISCOUNT_DB_SERVER=discount-db
DISCOUNT_DB_PORT=1433
DISCOUNT_DB_NAME=MABS_Discount
DISCOUNT_DB_USER=sa

# Service Configuration
ASPNETCORE_ENVIRONMENT=Development
DISCOUNT_SERVICE_HTTP_PORT=6007
DISCOUNT_SERVICE_GRPC_PORT=6017

# Logging Configuration
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_MICROSOFT=Warning
LOG_LEVEL_ENTITYFRAMEWORK=Information

# Security Configuration (Production)
# JWT_SECRET_KEY=your-super-secret-jwt-key-here
# ENCRYPTION_KEY=your-encryption-key-here

# External Services (if needed)
# REDIS_CONNECTION_STRING=localhost:6379
# RABBITMQ_CONNECTION_STRING=amqp://guest:guest@localhost:5672

# Monitoring and Health Checks
HEALTH_CHECK_TIMEOUT=30s
HEALTH_CHECK_INTERVAL=60s

# Resource Limits (Production)
MEMORY_LIMIT=1G
CPU_LIMIT=0.5

# Docker Network
DOCKER_NETWORK=discount-network

# Volume Paths
DB_DATA_PATH=./data/db
LOG_DATA_PATH=./data/logs

# Build Configuration
BUILD_CONFIGURATION=Release
DOCKER_IMAGE_TAG=latest
