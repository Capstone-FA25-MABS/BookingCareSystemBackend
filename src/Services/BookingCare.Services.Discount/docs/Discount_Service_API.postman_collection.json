    {
      "name": "Calculate Discount Amount",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{created_discount_code}}\",\n  \"originalAmount\": 150.00,\n  \"clinicId\": {{clinic_id}},\n  \"specialtyId\": 2,\n  \"doctorId\": 3\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/discounts/calculate",
          "host": ["{{base_url}}"],
