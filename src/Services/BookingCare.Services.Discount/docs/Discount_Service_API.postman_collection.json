          "path": ["api", "discounts", "use"]
        }
      }
    },
    {
      "name": "Revert Discount Usage",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{created_discount_code}}\",\n  \"clinicId\": {{clinic_id}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/discounts/revert",
          "host": ["{{base_url}}"],
          "path": ["api", "discounts", "revert"]
