        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{created_discount_code}}\",\n  \"clinicId\": {{clinic_id}},\n  \"specialtyId\": 2,\n  \"doctorId\": 3,\n  \"totalAmount\": 100.00\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/discounts/validate",
          "host": ["{{base_url}}"],
          "path": ["api", "discounts", "validate"]
        }
      }
    },
