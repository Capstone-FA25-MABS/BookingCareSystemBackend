<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress proto type conflicts warnings -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="7.2.4" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.5" />
    <PackageReference Include="Grpc.Net.Client" Version="2.57.0" />
    <PackageReference Include="Grpc.Tools" Version="2.57.0" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" Version="3.24.4" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../Services/BookingCare.Services.Auth/Protos/auth.proto" GrpcServices="Client" />
    <Protobuf Include="../../Services/BookingCare.Services.User/Protos/user.proto" GrpcServices="Client" />
    <Protobuf Include="../../Services/BookingCare.Services.Doctor/Protos/doctor.proto" GrpcServices="Client" />
    <Protobuf Include="../../Services/BookingCare.Services.Hospital/Protos/hospital.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookingCare.Shared.EventBus\BookingCare.Shared.EventBus.csproj" />
    <ProjectReference Include="..\BookingCare.Shared.Common\BookingCare.Shared.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed SQL schema file as resource -->
    <EmbeddedResource Include="Database\saga_schema.sql" />
  </ItemGroup>

</Project>