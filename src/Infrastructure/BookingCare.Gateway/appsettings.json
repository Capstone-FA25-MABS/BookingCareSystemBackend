{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YourSuperSecretKey1234567890123456",
    "Issuer": "BookingCareSystem",
    "Audience": "BookingCareClients",
    "ExpireMinutes": 60
  },
  "Consul": {
    "Host": "localhost",
    "Port": 8500
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
